@using WlcSistemaPedidos.Models
@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "Categorias";
    Layout = "_AdminLayout";
}

@section Styles {

    <style>

        .categorias-conteudo {
            width: 90%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 35px 0;
        }

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .cabecalho h1 {
            font-size: 27px;
            margin: 0 0 6px 0;
        }

        .cabecalho p {
            color: #777777;
            font-size: 14px;
            margin: 0;
        }

        .btn-novo {
            background: #f57c00;
            color: #ffffff;
            text-decoration: none;
            padding: 13px 18px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: bold;
            white-space: nowrap;
        }

        .btn-novo:hover {
            background: #e66f00;
            color: #ffffff;
        }

        .mensagem {
            padding: 13px 15px;
            border-radius: 9px;
            margin-bottom: 18px;
            font-size: 13px;
        }

        .mensagem-sucesso {
            background: #eaf8ef;
            border: 1px solid #b7e4c7;
            color: #207a3c;
        }

        .mensagem-erro {
            background: #fff0f0;
            border: 1px solid #f2b8b5;
            color: #b42318;
        }

        .tabela-container {
            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 13px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 700px;
        }

        th {
            background: #fafafa;
            color: #666666;
            font-size: 12px;
            text-align: left;
            padding: 15px;
            border-bottom: 1px solid #eeeeee;
        }

        td {
            padding: 15px;
            border-bottom: 1px solid #eeeeee;
            font-size: 14px;
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .categoria-nome strong {
            display: block;
            margin-bottom: 4px;
        }

        .categoria-nome small {
            color: #888888;
            line-height: 1.4;
        }

        .quantidade {
            font-weight: bold;
            color: #444444;
        }

        .status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }

        .status-ativa {
            background: #eaf8ef;
            color: #207a3c;
        }

        .status-inativa {
            background: #fff0f0;
            color: #b42318;
        }

        .acoes {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .btn-editar {
            text-decoration: none;
            color: #444444;
            background: #ffffff;
            border: 1px solid #dddddd;
            border-radius: 7px;
            padding: 8px 11px;
            font-size: 12px;
        }

        .btn-editar:hover {
            color: #f57c00;
            border-color: #f57c00;
        }

        .form-excluir {
            display: inline;
            margin: 0;
        }

        .btn-excluir {
            background: #ffffff;
            color: #b42318;
            border: 1px solid #f2b8b5;
            border-radius: 7px;
            padding: 8px 11px;
            font-size: 12px;
            cursor: pointer;
        }

        .btn-excluir:hover {
            background: #fff0f0;
        }

        .vazio {
            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 13px;
            padding: 55px 20px;
            text-align: center;
            color: #777777;
        }

        .vazio strong {
            display: block;
            color: #333333;
            font-size: 17px;
            margin-bottom: 7px;
        }

        @@media (max-width: 750px) {

            .categorias-conteudo {
                width: 92%;
            }

            .cabecalho {
                flex-direction: column;
                align-items: flex-start;
            }
        }

    </style>
}

<div class="categorias-conteudo">

    <div class="cabecalho">

        <div>

            <h1>Categorias</h1>

            <p>
                Organize os produtos do estabelecimento por categorias.
            </p>

        </div>

        <a asp-controller="Categorias"
           asp-action="Criar"
           class="btn-novo">
            + Nova Categoria
        </a>

    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="mensagem mensagem-sucesso">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="mensagem mensagem-erro">
            @TempData["Erro"]
        </div>
    }

    @if (Model.Any())
    {
        <div class="tabela-container">

            <table>

                <thead>
                    <tr>
                        <th>Categoria</th>
                        <th>Produtos</th>
                        <th>Ordem</th>
                        <th>Situação</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var categoria in Model)
                    {
                        <tr>

                            <td>

                                <div class="categoria-nome">

                                    <strong>
                                        @categoria.Nome
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(categoria.Descricao))
                                    {
                                        <small>
                                            @categoria.Descricao
                                        </small>
                                    }

                                </div>

                            </td>

                            <td>
                                <span class="quantidade">
                                    @categoria.Produtos.Count
                                </span>
                            </td>

                            <td>
                                @categoria.OrdemExibicao
                            </td>

                            <td>

                                @if (categoria.Ativa)
                                {
                                    <span class="status status-ativa">
                                        Ativa
                                    </span>
                                }
                                else
                                {
                                    <span class="status status-inativa">
                                        Inativa
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="acoes">

                                    <a asp-controller="Categorias"
                                       asp-action="Editar"
                                       asp-route-id="@categoria.Id"
                                       class="btn-editar">
                                        Editar
                                    </a>

                                    <form asp-controller="Categorias"
                                          asp-action="Excluir"
                                          asp-route-id="@categoria.Id"
                                          method="post"
                                          class="form-excluir"
                                          onsubmit="return confirm('Deseja realmente excluir esta categoria?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-excluir">
                                            Excluir
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="vazio">

            <strong>
                Nenhuma categoria cadastrada
            </strong>

            Cadastre a primeira categoria para começar a organizar os produtos.

        </div>
    }

</div>