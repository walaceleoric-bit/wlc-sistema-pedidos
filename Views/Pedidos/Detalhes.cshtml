@model WlcSistemaPedidos.Models.Pedido

@{
    Layout = null;
    ViewData["Title"] = $"Pedido #{Model.Id}";

    string nomeEstabelecimento =
        ViewBag.NomeEstabelecimento
        ?? "Sistema de Pedidos";

    string logoEstabelecimento =
        ViewBag.LogoEstabelecimento
        ?? "/images/logo-wlc.png";
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Pedido #@Model.Id - @nomeEstabelecimento
    </title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #f5f5f5;
                color: #292929;
            }

            /* ==========================================
                                   TOPO
                                   ========================================== */

            .topo {
                background: #ffffff;
                border-bottom: 3px solid #f58220;
                padding: 12px 20px;
            }

            .marca {
                max-width: 850px;
                margin: auto;
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .marca img {
                    width: 58px;
                    height: 58px;
                    object-fit: contain;
                }

                .marca strong {
                    display: block;
                    font-size: 17px;
                }

                .marca span {
                    display: block;
                    color: #777777;
                    font-size: 12px;
                    margin-top: 3px;
                }

            /* ==========================================
                                   CONTEÚDO
                                   ========================================== */

            .container {
                max-width: 850px;
                margin: auto;
                padding: 30px 20px 45px;
            }

            .acoes {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                margin-bottom: 18px;
            }

            .btn {
                min-height: 42px;
                border: 0;
                border-radius: 8px;
                padding: 0 17px;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .btn-voltar {
                background: #ffffff;
                color: #e96e00;
                border: 1px solid #f58220;
            }

            .btn-imprimir {
                background: #f58220;
                color: #ffffff;
            }

                .btn-imprimir:hover {
                    background: #e66f00;
                }

            /* ==========================================
                                   PEDIDO
                                   ========================================== */

            .pedido {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 14px;
                overflow: hidden;
            }

            .pedido-cabecalho {
                text-align: center;
                padding: 16px 20px;
                border-bottom: 1px dashed #cccccc;
            }

                .pedido-cabecalho h1 {
                    margin: 0 0 7px;
                    font-size: 27px;
                }

                .pedido-cabecalho p {
                    margin: 0;
                    color: #777777;
                    font-size: 13px;
                }

            .secao {
                padding: 12px 24px;
                border-bottom: 1px dashed #cccccc;
            }

                .secao:last-child {
                    border-bottom: 0;
                }

                .secao h2 {
                    margin: 0 0 13px;
                    font-size: 17px;
                    color: #333333;
                }

            .linha {
                display: flex;
                justify-content: space-between;
                gap: 20px;
                padding: 4px 0;
                font-size: 14px;
            }

                .linha span:first-child {
                    color: #666666;
                }

                .linha strong {
                    text-align: right;
                }

            /* ==========================================
                                   ITENS
                                   ========================================== */

            .item {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 100px;
                gap: 15px;
                padding: 6px 0;
                border-bottom: 1px solid #eeeeee;
            }

                .item:last-of-type {
                    border-bottom: 0;
                }

            .item-descricao {
                font-size: 14px;
            }

                .item-descricao strong {
                    display: block;
                }

                .item-descricao span {
                    display: block;
                    margin-top: 3px;
                    color: #777777;
                    font-size: 12px;
                }

            .item-valor {
                text-align: right;
                font-weight: 700;
                font-size: 14px;
            }

            /* ==========================================
                                   TOTAL
                                   ========================================== */

            .resumo {
                margin-top: 15px;
                border-top: 2px solid #eeeeee;
                padding-top: 10px;
            }

            .total {
                font-size: 21px;
                font-weight: 900;
                color: #f58220;
                padding-top: 12px;
            }

            /* ==========================================
                                   OBSERVAÇÃO
                                   ========================================== */

            .observacao {
                background: #fffaf5;
                border-radius: 8px;
                padding: 13px;
                color: #555555;
                line-height: 1.5;
                font-size: 14px;
            }

            /* ==========================================
                                   RODAPÉ
                                   ========================================== */

            footer {
                text-align: center;
                padding: 25px 15px;
                color: #777777;
                font-size: 12px;
            }

                footer strong {
                    color: #f58220;
                }

            .contato {
                margin-top: 5px;
                color: #999999;
                font-size: 11px;
            }

            .folha-impressao {
                display: none;
            }

            .via-impressao {
                color: #000;
                padding: 3mm 5mm;
                display: flex;
                flex-direction: column;
            }

            .via-cabecalho {
                text-align: center;
                border-bottom: 1px solid #999;
                padding-bottom: 7px;
                margin-bottom: 8px;
            }

                .via-cabecalho strong {
                    display: block;
                    font-size: 15px;
                }

                .via-cabecalho h2 {
                    margin: 3px 0;
                    font-size: 21px;
                }

                .via-cabecalho span {
                    font-size: 11px;
                }

            .via-titulo {
                margin: 7px 0 4px;
                font-size: 13px;
                font-weight: 800;
            }

            .via-linha {
                display: flex;
                justify-content: space-between;
                gap: 15px;
                padding: 3px 0;
                font-size: 12px;
                line-height: 1.3;
            }

                .via-linha span:first-child {
                    color: #555;
                }

                .via-linha strong {
                    text-align: right;
                }

            .via-itens {
                margin-top: 4px;
                border-top: 1px solid #bbb;
                border-bottom: 1px solid #bbb;
                padding: 4px 0;
            }

            .via-item {
                display: grid;
                grid-template-columns: 1fr auto;
                gap: 12px;
                padding: 3px 0;
                font-size: 12px;
            }

                .via-item small {
                    display: block;
                    margin-top: 2px;
                    color: #666;
                    font-size: 10px;
                }

            .via-total {
                font-size: 16px;
                font-weight: 900;
                padding-top: 5px;
            }

            .via-observacao {
                margin-top: 5px;
                padding: 5px 7px;
                border: 1px solid #ccc;
                border-radius: 4px;
                font-size: 10px;
                line-height: 1.3;
            }

            .via-assinatura {
                margin-top: auto;
                padding-top: 8px;
                display: grid;
                grid-template-columns: minmax(0, 1fr) 125px;
                gap: 25px;
                align-items: end;
            }

            .assinatura-campo,
            .data-campo {
                text-align: center;
                font-size: 10px;
                color: #444;
            }

            .assinatura-linha,
            .data-linha {
                border-top: 1px solid #333;
                padding-top: 4px;
            }

            .divisor-vias {
                display: flex;
                align-items: center;
                gap: 8px;
                height: 7mm;
                font-size: 9px;
                font-weight: 700;
                color: #777;
            }

                .divisor-vias::before, .divisor-vias::after {
                    content: "";
                    flex: 1;
                    border-top: 1px dashed #777;
                }

            /* ==========================================
                                   CELULAR
                                   ========================================== */

            @@media (max-width: 550px) {

                .acoes {
                    flex-direction: column;
                    align-items: stretch;
                }

                .btn {
                    width: 100%;
                }

                .linha {
                    flex-direction: column;
                    gap: 4px;
                }

                    .linha strong {
                        text-align: left;
                    }
            }

            /* ==========================================
                                   IMPRESSÃO
                                   ========================================== */

            @@media print {
                @@page {
                    size: A4 portrait;
                    margin: 7mm 9mm;
                }

                body {
                    background: #fff;
                }

                .topo, .acoes, .pedido, footer {
                    display: none !important;
                }

                .container {
                    max-width: none;
                    margin: 0;
                    padding: 0;
                }

                .folha-impressao {
                    display: block !important;
                    width: 100%;
                }

                .via-impressao {
                    height: 132mm;
                    overflow: hidden;
                    page-break-inside: avoid;
                    break-inside: avoid;
                }
            }

    </style>

</head>

<body>

    <header class="topo">

        <div class="marca">

            <img src="@logoEstabelecimento"
                 alt="@nomeEstabelecimento" />

            <div>

                <strong>
                    @nomeEstabelecimento
                </strong>

                <span>
                    Pedido para impressão
                </span>

            </div>

        </div>

    </header>

    <main class="container">

        <div class="acoes">

            <a asp-controller="Pedidos"
               asp-action="Index"
               class="btn btn-voltar">

                ← Voltar para pedidos

            </a>

            <button type="button"
                    class="btn btn-imprimir"
                    onclick="window.print()">

                🖨 Imprimir pedido

            </button>

        </div>

        <article class="pedido">

            <!-- =====================================
                 CABEÇALHO DO PEDIDO
                 ===================================== -->

            <div class="pedido-cabecalho">

                <h1>
                    Pedido #@Model.Id
                </h1>

                <p>
                    @(Model.DataPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                </p>

            </div>

            <!-- =====================================
                 CLIENTE
                 ===================================== -->

            <section class="secao">

                <h2>
                    Cliente
                </h2>

                <div class="linha">

                    <span>
                        Nome
                    </span>

                    <strong>
                        @Model.NomeCliente
                    </strong>

                </div>

                <div class="linha">

                    <span>
                        Telefone
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(
                            Model.TelefoneCliente)
                                ? "-"
                                : Model.TelefoneCliente)
                    </strong>

                </div>

            </section>

            <!-- =====================================
                 ENTREGA
                 ===================================== -->

            <section class="secao">

                <h2>
                    Entrega
                </h2>

                <div class="linha">

                    <span>
                        Endereço
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(
                            Model.EnderecoEntrega)
                                ? "-"
                                : Model.EnderecoEntrega)

                        @if (!string.IsNullOrWhiteSpace(
                            Model.NumeroEntrega))
                        {
                            <text>, @Model.NumeroEntrega</text>
                        }
                    </strong>

                </div>

                <div class="linha">

                    <span>
                        Bairro
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(
                            Model.BairroEntrega)
                                ? "-"
                                : Model.BairroEntrega)
                    </strong>

                </div>

                <div class="linha">

                    <span>
                        Complemento
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(
                            Model.ComplementoEntrega)
                                ? "-"
                                : Model.ComplementoEntrega)
                    </strong>

                </div>

            </section>

            <!-- =====================================
                 ITENS
                 ===================================== -->

            <section class="secao">

                <h2>
                    Itens do pedido
                </h2>

                @foreach (var item in Model.Itens)
                {
                    <div class="item">

                        <div class="item-descricao">

                            <strong>
                                @item.Quantidade x
                                @item.NomeProduto
                            </strong>

                            <span>
                                @item.PrecoUnitario.ToString("C2")
                                cada
                            </span>

                        </div>

                        <div class="item-valor">
                            @item.Subtotal.ToString("C2")
                        </div>

                    </div>
                }

                <div class="resumo">

                    <div class="linha">

                        <span>
                            Subtotal
                        </span>

                        <strong>
                            @Model.Subtotal.ToString("C2")
                        </strong>

                    </div>

                    <div class="linha total">

                        <span>
                            TOTAL
                        </span>

                        <strong>
                            @Model.Total.ToString("C2")
                        </strong>

                    </div>

                </div>

            </section>

            <!-- =====================================
                 OBSERVAÇÃO
                 ===================================== -->
            @if (!string.IsNullOrWhiteSpace(
                            Model.Observacao))
            {
                <section class="secao">

                    <h2>
                        Observação
                    </h2>

                    <div class="observacao">
                        @Model.Observacao
                    </div>

                </section>
            }

        </article>

        <div class="folha-impressao">
            @for (int via = 1; via <= 2; via++)
            {
                <section class="via-impressao">
                    <div class="via-cabecalho">
                        <strong>@nomeEstabelecimento</strong>
                        <h2>Pedido #@Model.Id</h2>
                        <span>@(Model.DataPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm")) · @(via == 1 ? "VIA DO CLIENTE" : "VIA DO ESTABELECIMENTO")</span>
                    </div>
                    <div class="via-titulo">Cliente</div>
                    <div class="via-linha"><span>Nome</span><strong>@Model.NomeCliente</strong></div>
                    <div class="via-linha"><span>Telefone</span><strong>@(string.IsNullOrWhiteSpace(Model.TelefoneCliente) ? "-" : Model.TelefoneCliente)</strong></div>
                    <div class="via-titulo">Entrega</div>
                    <div class="via-linha">
                        <span>Endereço</span><strong>
                        @(string.IsNullOrWhiteSpace(Model.EnderecoEntrega) ? "-" : Model.EnderecoEntrega) @if (!string.IsNullOrWhiteSpace(Model.NumeroEntrega)) {
                        <text>, @Model.NumeroEntrega</text>
                    }
                </strong>
            </div>
            <div class="via-linha"><span>Bairro</span><strong>@(string.IsNullOrWhiteSpace(Model.BairroEntrega) ? "-" : Model.BairroEntrega)</strong></div>
            <div class="via-linha"><span>Complemento</span><strong>@(string.IsNullOrWhiteSpace(Model.ComplementoEntrega) ? "-" : Model.ComplementoEntrega)</strong></div>
            <div class="via-titulo">Itens do pedido</div>
            <div class="via-itens">
                @foreach (var item in Model.Itens)
                {
                    <div class="via-item"><div><strong>@item.Quantidade x @item.NomeProduto</strong><small>@item.PrecoUnitario.ToString("C2") cada</small></div><strong>@item.Subtotal.ToString("C2")</strong></div>
                }
            </div>
            <div class="via-linha"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C2")</strong></div>
            <div class="via-linha via-total"><span>TOTAL</span><strong>@Model.Total.ToString("C2")</strong></div>
            @if (!string.IsNullOrWhiteSpace(Model.Observacao))
            {
                <div class="via-observacao"><strong>Observação:</strong> @Model.Observacao</div>
            }

            <div class="via-assinatura">

                <div class="assinatura-campo">
                    <div class="assinatura-linha">
                        Assinatura de quem recebeu
                    </div>
                </div>

                <div class="data-campo">
                    <div class="data-linha">
                        Data: ____/____/______
                    </div>
                </div>

            </div>

        </section>
        @if (via == 1)
        {
            <div class="divisor-vias">CORTE AQUI</div>
        }
    }
</div>

</main>

<footer>

    <div>
        Desenvolvido por
        <strong>WLC Sistemas</strong>
    </div>

    <div class="contato">
        Whatsapp: (27) 98843-3016
    </div>

</footer>

</body>

</html>