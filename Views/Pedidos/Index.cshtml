@using WlcSistemaPedidos.Models
@model IEnumerable<Pedido>

@{
    Layout = null;
    ViewData["Title"] = "Pedidos";

    string nomeEstabelecimento =
        ViewBag.NomeEstabelecimento
        ?? "Sistema de Pedidos";

    string logoEstabelecimento =
        ViewBag.LogoEstabelecimento
        ?? "/images/logo-wlc.png";

    int paginaAtual =
        ViewBag.PaginaAtual ?? 1;

    int totalPaginas =
        ViewBag.TotalPaginas ?? 0;

    int totalPedidos =
        ViewBag.TotalPedidos ?? 0;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Pedidos - @nomeEstabelecimento
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f5f5;
            color: #292929;
        }

        /* ==========================================
           TOPO
           ========================================== */

        .topo {
            background: #ffffff;
            border-bottom: 3px solid #f58220;
        }

        .topo-conteudo {
            max-width: 1200px;
            margin: auto;
            padding: 10px 20px;
            min-height: 78px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;
        }

        .marca {
            display: flex;
            align-items: center;
            gap: 12px;

            text-decoration: none;
            color: #222222;
        }

        .marca img {
            width: 58px;
            height: 58px;
            object-fit: contain;
        }

        .marca strong {
            display: block;
            font-size: 17px;
        }

        .marca span {
            display: block;
            color: #777777;
            font-size: 12px;
            margin-top: 3px;
        }

        /* ==========================================
           MENU
           ========================================== */

        .menu {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .menu a,
        .btn-sair {
            padding: 10px 13px;
            border-radius: 8px;

            text-decoration: none;

            color: #333333;

            font-weight: 700;
            font-size: 14px;

            border: 0;
            background: transparent;

            cursor: pointer;

            font-family: inherit;
        }

        .menu a:hover,
        .menu .ativo,
        .btn-sair:hover {
            background: #f58220;
            color: #ffffff;
        }

        .menu form {
            margin: 0;
        }

        /* ==========================================
           CONTEÚDO
           ========================================== */

        .container {
            max-width: 1200px;
            margin: auto;
            padding: 28px 20px 45px;
        }

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;

            gap: 15px;

            margin-bottom: 20px;
        }

        h1 {
            margin: 0 0 5px;
            font-size: 28px;
        }

        .subtitulo {
            margin: 0;
            color: #777777;
            font-size: 14px;
        }

        /* ==========================================
           MENSAGEM
           ========================================== */

        .mensagem {
            background: #eef9f0;
            color: #218838;

            border: 1px solid #cce8d1;
            border-radius: 10px;

            padding: 13px 15px;

            margin-bottom: 20px;

            font-size: 14px;
            font-weight: 700;
        }

        /* ==========================================
           TABELA
           ========================================== */

        .tabela-box {
            background: #ffffff;

            border: 1px solid #e5e5e5;
            border-radius: 12px;

            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 750px;
        }

        th,
        td {
            padding: 14px 13px;

            text-align: left;

            border-bottom: 1px solid #eeeeee;

            font-size: 13px;

            vertical-align: middle;
        }

        th {
            background: #fafafa;
            color: #555555;
        }

        tbody tr:hover {
            background: #fffaf5;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        .numero-pedido {
            color: #f58220;
            font-size: 14px;
        }

        .valor-pedido {
            font-size: 14px;
        }

        /* ==========================================
           BOTÃO IMPRIMIR
           ========================================== */

        .btn-imprimir {
            border: 0;

            border-radius: 8px;

            padding: 10px 15px;

            font-weight: 700;
            font-size: 13px;

            cursor: pointer;

            text-decoration: none;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            background: #f58220;
            color: #ffffff;

            white-space: nowrap;
        }

        .btn-imprimir:hover {
            background: #e66f00;
            color: #ffffff;
        }

        /* ==========================================
           VAZIO
           ========================================== */

        .vazio {
            background: #ffffff;

            border: 1px solid #e5e5e5;
            border-radius: 12px;

            padding: 40px;

            text-align: center;

            color: #777777;
        }

        /* ==========================================
           PAGINAÇÃO
           ========================================== */

        .paginacao {
            display: flex;
            justify-content: center;

            gap: 7px;

            margin-top: 25px;

            flex-wrap: wrap;
        }

        .paginacao a,
        .paginacao span {
            min-width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 1px solid #dddddd;
            border-radius: 8px;

            background: #ffffff;

            color: #333333;

            text-decoration: none;

            font-weight: 700;
        }

        .paginacao a:hover {
            border-color: #f58220;
            color: #f58220;
        }

        .paginacao .ativa {
            background: #f58220;
            color: #ffffff;
            border-color: #f58220;
        }

        /* ==========================================
           RODAPÉ
           ========================================== */

        footer {
            background: #ffffff;

            border-top: 1px solid #e5e5e5;

            padding: 22px;

            text-align: center;

            color: #777777;

            font-size: 12px;
        }

        footer strong {
            color: #f58220;
        }

        .contato {
            margin-top: 5px;
            font-size: 11px;
            color: #999999;
        }

        /* ==========================================
           RESPONSIVO
           ========================================== */

        @@media (max-width: 700px) {

            .topo-conteudo,
            .cabecalho {
                flex-direction: column;
                align-items: stretch;
            }

            .menu {
                justify-content: center;
            }

        }

    </style>

</head>

<body>

    <header class="topo">

        <div class="topo-conteudo">

            <a asp-controller="Admin"
               asp-action="Index"
               class="marca">

                <img src="@logoEstabelecimento"
                     alt="@nomeEstabelecimento" />

                <div>

                    <strong>
                        @nomeEstabelecimento
                    </strong>

                    <span>
                        Painel Administrativo
                    </span>

                </div>

            </a>

            <nav class="menu">

                <a asp-controller="Admin"
                   asp-action="Index">
                    Início
                </a>

                <a asp-controller="Pedidos"
                   asp-action="Index"
                   class="ativo">
                    Pedidos
                </a>

                <a asp-controller="Pedidos"
                   asp-action="Historico">
                    Histórico
                </a>

                <a asp-controller="Produtos"
                   asp-action="Index">
                    Produtos
                </a>

                <a asp-controller="Clientes"
                   asp-action="Index">
                    Clientes
                </a>

                <a asp-controller="Lembretes"
                   asp-action="Index">
                    Lembretes
                </a>

                <a asp-controller="NotasFiscais"
                   asp-action="Index">
                    NF
                </a>

                <a asp-controller="Configuracoes"
                   asp-action="Index">
                    Configurações
                </a>

                <form asp-controller="Conta"
                      asp-action="Sair"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn-sair">
                        Sair
                    </button>

                </form>

            </nav>

        </div>

    </header>

    <main class="container">

        <div class="cabecalho">

            <div>

                <h1>
                    Pedidos
                </h1>

                <p class="subtitulo">
                    @totalPedidos pedido(s) encontrado(s)
                </p>

            </div>

        </div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="mensagem">
                @TempData["Sucesso"]
            </div>
        }

        @if (Model.Any())
        {
            <div class="tabela-box">

                <table>

                    <thead>

                        <tr>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Telefone</th>
                            <th>Data</th>
                            <th>Total</th>
                            <th>Ação</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var pedido in Model)
                        {
                            <tr>

                                <td>
                                    <strong class="numero-pedido">
                                        #@pedido.Id
                                    </strong>
                                </td>

                                <td>
                                    @pedido.NomeCliente
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        pedido.TelefoneCliente)
                                            ? "-"
                                            : pedido.TelefoneCliente)
                                </td>

                                <td>
                                    @(pedido.DataPedido
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>
                                    <strong class="valor-pedido">
                                        @pedido.Total.ToString("C2")
                                    </strong>
                                </td>

                                <td>

                                    <a asp-controller="Pedidos"
                                       asp-action="Detalhes"
                                       asp-route-id="@pedido.Id"
                                       class="btn-imprimir">

                                        🖨 Imprimir

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (totalPaginas > 1)
            {
                <nav class="paginacao">

                    @if (paginaAtual > 1)
                    {
                        <a asp-controller="Pedidos"
                           asp-action="Index"
                           asp-route-pagina="@(paginaAtual - 1)">
                            ‹
                        </a>
                    }

                    @for (int i = 1;
                          i <= totalPaginas;
                          i++)
                    {
                        if (i == paginaAtual)
                        {
                            <span class="ativa">
                                @i
                            </span>
                        }
                        else
                        {
                            <a asp-controller="Pedidos"
                               asp-action="Index"
                               asp-route-pagina="@i">
                                @i
                            </a>
                        }
                    }

                    @if (paginaAtual < totalPaginas)
                    {
                        <a asp-controller="Pedidos"
                           asp-action="Index"
                           asp-route-pagina="@(paginaAtual + 1)">
                            ›
                        </a>
                    }

                </nav>
            }
        }
        else
        {
            <div class="vazio">
                Nenhum pedido encontrado.
            </div>
        }

    </main>

    <footer>

        <div>
            Desenvolvido por
            <strong>WLC Sistemas</strong>
        </div>

        <div class="contato">
            Whatsapp: (27) 98843-3016
        </div>

    </footer>

</body>

</html>