@using WlcSistemaPedidos.Models
@model IEnumerable<Pedido>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Histórico de Pedidos";

    var cultura =
        new System.Globalization.CultureInfo("pt-BR");

    int paginaAtual =
        ViewBag.PaginaAtual ?? 1;

    int totalPaginas =
        ViewBag.TotalPaginas ?? 0;

    int totalPedidos =
        ViewBag.TotalPedidos ?? 0;

    string busca =
        ViewBag.Busca as string ?? "";

    StatusPedido? statusSelecionado =
        ViewBag.StatusSelecionado as StatusPedido?;
}

@section Styles {
<style>
.historico-conteudo {
                width: 90%;
                max-width: 1200px;
                margin: 0 auto;
                padding: 38px 0;
                flex: 1;
            }

            .cabecalho {
                margin-bottom: 20px;
            }

                .cabecalho h1 {
                    font-size: 27px;
                    margin-bottom: 7px;
                }

                .cabecalho p {
                    color: #777777;
                    font-size: 14px;
                }

            .filtros {
                background: #ffffff;
                border: 1px solid #eeeeee;
                border-radius: 14px;
                padding: 16px;
                margin-bottom: 18px;
            }

            .filtros-form {
                display: grid;
                grid-template-columns: 1fr 220px auto auto;
                gap: 10px;
                align-items: center;
            }

            .campo {
                width: 100%;
                border: 1px solid #d8d8d8;
                border-radius: 8px;
                padding: 11px 12px;
                font-size: 14px;
                outline: none;
                background: #ffffff;
            }

                .campo:focus {
                    border-color: #f57c00;
                    box-shadow: 0 0 0 3px rgba(245,124,0,.10);
                }

            .btn-buscar,
            .btn-limpar {
                border-radius: 8px;
                padding: 11px 16px;
                font-size: 13px;
                font-weight: bold;
                text-decoration: none;
                cursor: pointer;
                white-space: nowrap;
            }

            .btn-buscar {
                border: 1px solid #f57c00;
                background: #f57c00;
                color: #ffffff;
            }

                .btn-buscar:hover {
                    background: #e66f00;
                }

            .btn-limpar {
                border: 1px solid #dddddd;
                background: #ffffff;
                color: #555555;
                text-align: center;
            }

                .btn-limpar:hover {
                    border-color: #f57c00;
                    color: #f57c00;
                }

            .resultado-filtro {
                margin-top: 10px;
                color: #777777;
                font-size: 12px;
            }

            .tabela-box {
                background: #ffffff;
                border: 1px solid #eeeeee;
                border-radius: 14px;
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 850px;
            }

            th,
            td {
                padding: 15px 16px;
                text-align: left;
                border-bottom: 1px solid #eeeeee;
                font-size: 13px;
            }

            th {
                background: #fafafa;
                color: #666666;
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            .pedido {
                font-weight: bold;
            }

            .status {
                display: inline-block;
                padding: 6px 10px;
                border-radius: 20px;
                font-weight: bold;
                font-size: 11px;
            }

                .status.finalizado {
                    background: #edf8f0;
                    color: #207a3c;
                }

                .status.cancelado {
                    background: #fff0f0;
                    color: #b42318;
                }

            .btn-detalhes {
                display: inline-block;
                color: #f57c00;
                border: 1px solid #f57c00;
                border-radius: 8px;
                padding: 8px 12px;
                text-decoration: none;
                font-weight: bold;
                font-size: 12px;
            }

                .btn-detalhes:hover {
                    background: #f57c00;
                    color: #ffffff;
                }

            .vazio {
                background: #ffffff;
                border: 1px solid #eeeeee;
                border-radius: 14px;
                padding: 45px 20px;
                text-align: center;
                color: #777777;
            }

                .vazio strong {
                    display: block;
                    color: #333333;
                    margin-bottom: 8px;
                }

            .paginacao {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 7px;
                margin-top: 24px;
            }

                .paginacao a,
                .paginacao span {
                    min-width: 38px;
                    height: 38px;
                    padding: 0 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: #ffffff;
                    border: 1px solid #dddddd;
                    border-radius: 8px;
                    text-decoration: none;
                    color: #333333;
                    font-weight: bold;
                    font-size: 13px;
                }

                    .paginacao a:hover {
                        border-color: #f57c00;
                        color: #f57c00;
                    }

                .paginacao .ativa {
                    background: #f57c00;
                    border-color: #f57c00;
                    color: #ffffff;
                }

            
            @@media (max-width: 800px) {
                .filtros-form { grid-template-columns: 1fr; }
            }
            @@media (max-width: 550px) {
                .historico-conteudo { width: 92%; }
            }

</style>
}

<div class="historico-conteudo">
<section class="cabecalho">
            <h1>Histórico de pedidos</h1>
            <p>
                Consulte pedidos finalizados e cancelados.
            </p>
        </section>

        <section class="filtros">

            <form method="get"
                  asp-controller="Pedidos"
                  asp-action="Historico"
                  class="filtros-form">

                <input type="text"
                       name="busca"
                       value="@busca"
                       class="campo"
                       placeholder="Nº do pedido ou nome do cliente" />

                <select name="status"
                        class="campo">

                    <option value="">
                        Finalizados e cancelados
                    </option>

                    @if (statusSelecionado == StatusPedido.Finalizado)
                    {
                        <option value="@((int)StatusPedido.Finalizado)"
                                selected>
                            Finalizado
                        </option>
                    }
                    else
                    {
                        <option value="@((int)StatusPedido.Finalizado)">
                            Finalizado
                        </option>
                    }

                    @if (statusSelecionado == StatusPedido.Cancelado)
                    {
                        <option value="@((int)StatusPedido.Cancelado)"
                                selected>
                            Cancelado
                        </option>
                    }
                    else
                    {
                        <option value="@((int)StatusPedido.Cancelado)">
                            Cancelado
                        </option>
                    }

                </select>

                <button type="submit"
                        class="btn-buscar">
                    Buscar
                </button>

                <a asp-controller="Pedidos"
                   asp-action="Historico"
                   class="btn-limpar">
                    Limpar
                </a>

            </form>

            <div class="resultado-filtro">
                @totalPedidos pedido(s) encontrado(s).
            </div>

        </section>

        @if (Model.Any())
        {
            <section class="tabela-box">

                <table>

                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Data</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Detalhes</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var pedido in Model)
                        {
                            string classeStatus =
                                pedido.Status == StatusPedido.Cancelado
                                    ? "cancelado"
                                    : "finalizado";

                            <tr>

                                <td class="pedido">
                                    #@pedido.Id
                                </td>

                                <td>
                                    @pedido.NomeCliente
                                </td>

                                <td>
                                    @(pedido.DataPedido
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>
                                    <span class="status @classeStatus">
                                        @pedido.Status
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        @pedido.Total.ToString("C2", cultura)
                                    </strong>
                                </td>

                                <td>
                                    <a asp-controller="Pedidos"
                                       asp-action="Detalhes"
                                       asp-route-id="@pedido.Id"
                                       class="btn-detalhes">
                                        Visualizar
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </section>

            @if (totalPaginas > 1)
            {
                <nav class="paginacao">

                    @if (paginaAtual > 1)
                    {
                        <a asp-controller="Pedidos"
                           asp-action="Historico"
                           asp-route-pagina="@(paginaAtual - 1)"
                           asp-route-busca="@busca"
                           asp-route-status="@statusSelecionado">
                            ‹
                        </a>
                    }

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        if (i == paginaAtual)
                        {
                            <span class="ativa">@i</span>
                        }
                        else
                        {
                            <a asp-controller="Pedidos"
                               asp-action="Historico"
                               asp-route-pagina="@i"
                               asp-route-busca="@busca"
                               asp-route-status="@statusSelecionado">
                                @i
                            </a>
                        }
                    }

                    @if (paginaAtual < totalPaginas)
                    {
                        <a asp-controller="Pedidos"
                           asp-action="Historico"
                           asp-route-pagina="@(paginaAtual + 1)"
                           asp-route-busca="@busca"
                           asp-route-status="@statusSelecionado">
                            ›
                        </a>
                    }

                </nav>
            }
        }
        else
        {
            <section class="vazio">
                <strong>Nenhum pedido encontrado.</strong>
                Tente alterar a busca ou o filtro de status.
            </section>
        }
</div>
