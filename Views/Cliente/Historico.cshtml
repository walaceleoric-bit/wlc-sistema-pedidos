@using WlcSistemaPedidos.Models
@model IEnumerable<Pedido>

@{
    Layout = null;
    ViewData["Title"] = "Histórico de Pedidos";

    var cultura =
        new System.Globalization.CultureInfo("pt-BR");

    string nomeEstabelecimento =
        ViewBag.NomeEstabelecimento
        ?? "Sistema de Pedidos";

    string logoEstabelecimento =
        ViewBag.LogoEstabelecimento
        ?? "/images/logo-wlc.png";

    int paginaAtual =
        ViewBag.PaginaAtual ?? 1;

    int totalPaginas =
        ViewBag.TotalPaginas ?? 0;

    int totalPedidos =
        ViewBag.TotalPedidos ?? 0;

    decimal saldoDevedor =
        ViewBag.SaldoDevedor ?? 0m;

    string busca =
        ViewBag.Busca as string ?? "";

    StatusPedido? statusSelecionado =
        ViewBag.StatusSelecionado as StatusPedido?;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Histórico - @nomeEstabelecimento</title>

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                min-height: 100vh;
                font-family: Arial, Helvetica, sans-serif;
                background: #f6f7f9;
                color: #262626;
                display: flex;
                flex-direction: column;
            }

            .topo {
                background: #ffffff;
                border-bottom: 1px solid #e8e8e8;
                min-height: 72px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px 5%;
            }

            .marca {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .logo-estabelecimento {
                width: 95px;
                height: 48px;
                object-fit: contain;
            }

            .nome-sistema {
                border-left: 1px solid #dddddd;
                padding-left: 14px;
            }

                .nome-sistema strong {
                    display: block;
                    font-size: 15px;
                }

                .nome-sistema span {
                    font-size: 12px;
                    color: #888888;
                }

            .menu {
                display: flex;
                align-items: center;
                gap: 7px;
                flex-wrap: wrap;
            }

                .menu a,
                .btn-sair {
                    border: none;
                    background: transparent;
                    color: #444444;
                    text-decoration: none;
                    padding: 10px 13px;
                    border-radius: 8px;
                    font-size: 14px;
                    cursor: pointer;
                    font-family: inherit;
                }

                    .menu a:hover,
                    .btn-sair:hover {
                        background: #fff3e6;
                        color: #f57c00;
                    }

                .menu .ativo {
                    background: #f57c00;
                    color: #ffffff;
                }

            .form-sair {
                margin: 0;
            }

            .conteudo {
                width: 90%;
                max-width: 1100px;
                margin: 0 auto;
                padding: 38px 0;
                flex: 1;
            }

            .cabecalho {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                gap: 20px;
                margin-bottom: 20px;
            }

                .cabecalho h1 {
                    font-size: 27px;
                    margin-bottom: 7px;
                }

                .cabecalho p {
                    color: #777777;
                    font-size: 14px;
                }

            .saldo {
                background: #ffffff;
                border: 1px solid #eeeeee;
                border-radius: 12px;
                padding: 13px 17px;
                text-align: right;
            }

                .saldo span {
                    display: block;
                    color: #888888;
                    font-size: 11px;
                    margin-bottom: 4px;
                }

                .saldo strong {
                    font-size: 18px;
                    color: #207a3c;
                }

                    .saldo strong.devedor {
                        color: #b42318;
                    }

            .filtros {
                background: #ffffff;
                border: 1px solid #eeeeee;
                border-radius: 14px;
                padding: 16px;
                margin-bottom: 18px;
            }

            .filtros-form {
                display: grid;
                grid-template-columns: 1fr 240px auto auto;
                gap: 10px;
                align-items: center;
            }

            .campo {
                width: 100%;
                border: 1px solid #d8d8d8;
                border-radius: 8px;
                padding: 11px 12px;
                font-size: 14px;
                outline: none;
                background: #ffffff;
            }

                .campo:focus {
                    border-color: #f57c00;
                    box-shadow: 0 0 0 3px rgba(245,124,0,.10);
                }

            .btn-buscar,
            .btn-limpar {
                border-radius: 8px;
                padding: 11px 16px;
                font-size: 13px;
                font-weight: bold;
                text-decoration: none;
                cursor: pointer;
                white-space: nowrap;
            }

            .btn-buscar {
                border: 1px solid #f57c00;
                background: #f57c00;
                color: #ffffff;
            }

                .btn-buscar:hover {
                    background: #e66f00;
                }

            .btn-limpar {
                border: 1px solid #dddddd;
                background: #ffffff;
                color: #555555;
                text-align: center;
            }

                .btn-limpar:hover {
                    border-color: #f57c00;
                    color: #f57c00;
                }

            .resultado-filtro {
                margin-top: 10px;
                color: #777777;
                font-size: 12px;
            }

            .tabela-box {
                background: #ffffff;
                border: 1px solid #eeeeee;
                border-radius: 14px;
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 720px;
            }

            th,
            td {
                padding: 15px 16px;
                text-align: left;
                border-bottom: 1px solid #eeeeee;
                font-size: 13px;
            }

            th {
                background: #fafafa;
                color: #666666;
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            .pedido {
                font-weight: bold;
            }

            .status {
                display: inline-block;
                padding: 6px 10px;
                border-radius: 20px;
                background: #fff3e6;
                color: #e66f00;
                font-weight: bold;
                font-size: 11px;
            }

                .status.cancelado {
                    background: #fff0f0;
                    color: #b42318;
                }

                .status.finalizado {
                    background: #edf8f0;
                    color: #207a3c;
                }

            .btn-detalhes {
                display: inline-block;
                color: #f57c00;
                border: 1px solid #f57c00;
                border-radius: 8px;
                padding: 8px 12px;
                text-decoration: none;
                font-weight: bold;
                font-size: 12px;
            }

                .btn-detalhes:hover {
                    background: #f57c00;
                    color: #ffffff;
                }

            .vazio {
                background: #ffffff;
                border: 1px solid #eeeeee;
                border-radius: 14px;
                padding: 45px 20px;
                text-align: center;
                color: #777777;
            }

                .vazio strong {
                    display: block;
                    color: #333333;
                    margin-bottom: 8px;
                }

            .paginacao {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 7px;
                margin-top: 24px;
            }

                .paginacao a,
                .paginacao span {
                    min-width: 38px;
                    height: 38px;
                    padding: 0 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: #ffffff;
                    border: 1px solid #dddddd;
                    border-radius: 8px;
                    text-decoration: none;
                    color: #333333;
                    font-weight: bold;
                    font-size: 13px;
                }

                    .paginacao a:hover {
                        border-color: #f57c00;
                        color: #f57c00;
                    }

                .paginacao .ativa {
                    background: #f57c00;
                    border-color: #f57c00;
                    color: #ffffff;
                }

            .rodape {
                background: #ffffff;
                border-top: 1px solid #e8e8e8;
                text-align: center;
                padding: 18px;
                color: #777777;
                font-size: 12px;
            }

                .rodape strong {
                    color: #f57c00;
                }

            @@media (max-width: 800px) {
                .topo {
                    flex-direction: column;
                    gap: 10px;
                }

                .menu {
                    justify-content: center;
                }

                .cabecalho {
                    flex-direction: column;
                    align-items: stretch;
                }

                .saldo {
                    text-align: left;
                }

                .filtros-form {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 550px) {
                .conteudo {
                    width: 92%;
                }

                .nome-sistema {
                    display: none;
                }

                .marca {
                    justify-content: center;
                }

                .menu {
                    gap: 3px;
                }

                    .menu a,
                    .btn-sair {
                        padding: 8px 9px;
                        font-size: 13px;
                    }
            }
    </style>
</head>

<body>

    <header class="topo">

        <div class="marca">

            <img src="@logoEstabelecimento"
                 alt="@nomeEstabelecimento"
                 class="logo-estabelecimento" />

            <div class="nome-sistema">
                <strong>@nomeEstabelecimento</strong>
                <span>Área do Cliente</span>
            </div>

        </div>

        <nav class="menu">

            <a asp-controller="Home"
               asp-action="Index">
                Início
            </a>

            <a asp-controller="Cliente"
               asp-action="Historico"
               class="ativo">
                Histórico
            </a>

            <a asp-controller="Cliente"
               asp-action="Produtos">
                Produtos
            </a>

            <a asp-controller="Carrinho"
               asp-action="Index">
                Carrinho
            </a>

            <form asp-controller="Conta"
                  asp-action="Sair"
                  method="post"
                  class="form-sair">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-sair">
                    Sair
                </button>

            </form>

        </nav>

    </header>

    <main class="conteudo">

        <section class="cabecalho">

            <div>
                <h1>Histórico de pedidos</h1>
                <p>
                    Consulte seus pedidos anteriores.
                </p>
            </div>

            <div class="saldo">
                <span>Saldo atual</span>

                <strong class="@(saldoDevedor > 0 ? "devedor" : "")">
                    @(saldoDevedor > 0
                        ? saldoDevedor.ToString("C2", cultura)
                        : "Em dia")
                </strong>
            </div>

        </section>

        <section class="filtros">

            <form method="get"
                  asp-controller="Cliente"
                  asp-action="Historico"
                  class="filtros-form">

                <input type="text"
                       name="busca"
                       value="@busca"
                       class="campo"
                       inputmode="numeric"
                       placeholder="Buscar pelo nº do pedido. Ex.: 125 ou #125" />

                <select name="status"
                        class="campo">

                    <option value="">
                        Todos os status
                    </option>

                    @foreach (StatusPedido itemStatus in
                        Enum.GetValues(typeof(StatusPedido)))
                    {
                        if (statusSelecionado.HasValue &&
                            statusSelecionado.Value == itemStatus)
                        {
                            <option value="@((int)itemStatus)"
                                    selected>
                                @itemStatus
                            </option>
                        }
                        else
                        {
                            <option value="@((int)itemStatus)">
                                @itemStatus
                            </option>
                        }
                    }

                </select>

                <button type="submit"
                        class="btn-buscar">
                    Buscar
                </button>

                <a asp-controller="Cliente"
                   asp-action="Historico"
                   class="btn-limpar">
                    Limpar
                </a>

            </form>

            <div class="resultado-filtro">
                @totalPedidos pedido(s) encontrado(s).
            </div>

        </section>

        @if (Model.Any())
        {
            <section class="tabela-box">

                <table>

                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Data</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Detalhes</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var pedido in Model)
                        {
                            string classeStatus =
                                pedido.Status == StatusPedido.Cancelado
                                    ? "cancelado"
                                    : pedido.Status == StatusPedido.Finalizado
                                        ? "finalizado"
                                        : "";

                            <tr>

                                <td class="pedido">
                                    #@pedido.Id
                                </td>

                                <td>
                                    @(pedido.DataPedido
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>
                                    <span class="status @classeStatus">
                                        @pedido.Status
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        @pedido.Total.ToString("C2", cultura)
                                    </strong>
                                </td>

                                <td>
                                    <a asp-controller="Carrinho"
                                       asp-action="Sucesso"
                                       asp-route-id="@pedido.Id"
                                       class="btn-detalhes">
                                        Visualizar
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </section>

            @if (totalPaginas > 1)
            {
                <nav class="paginacao">

                    @if (paginaAtual > 1)
                    {
                        <a asp-controller="Cliente"
                           asp-action="Historico"
                           asp-route-pagina="@(paginaAtual - 1)"
                           asp-route-busca="@busca"
                           asp-route-status="@statusSelecionado">
                            ‹
                        </a>
                    }

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        if (i == paginaAtual)
                        {
                            <span class="ativa">@i</span>
                        }
                        else
                        {
                            <a asp-controller="Cliente"
                               asp-action="Historico"
                               asp-route-pagina="@i"
                               asp-route-busca="@busca"
                               asp-route-status="@statusSelecionado">
                                @i
                            </a>
                        }
                    }

                    @if (paginaAtual < totalPaginas)
                    {
                        <a asp-controller="Cliente"
                           asp-action="Historico"
                           asp-route-pagina="@(paginaAtual + 1)"
                           asp-route-busca="@busca"
                           asp-route-status="@statusSelecionado">
                            ›
                        </a>
                    }

                </nav>
            }
        }
        else
        {
            <section class="vazio">
                <strong>Nenhum pedido encontrado.</strong>
                Tente alterar o número do pedido ou o filtro de status.
            </section>
        }

    </main>

    <footer class="rodape">
        Desenvolvido por
        <strong>WLC Sistemas</strong>
    </footer>

</body>
</html>
