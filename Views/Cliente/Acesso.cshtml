@{
    ViewData["Title"] = "Acessar Cardápio";
    Layout = null;

    string nomeEstabelecimento =
        ViewBag.NomeEstabelecimento
        ?? "Sistema de Pedidos";

    string logoEstabelecimento =
        ViewBag.LogoEstabelecimento
        ?? "/images/logo-wlc.png";
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@nomeEstabelecimento</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #fff7ed, #f5f5f5);

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 20px;
        }

        .pagina {
            width: 100%;
            max-width: 430px;
        }

        .card {
            background: #ffffff;

            border-radius: 20px;

            padding: 38px 32px;

            box-shadow:
                0 15px 45px rgba(0, 0, 0, 0.10);

            border-top: 5px solid #f57c00;
        }

        .marca {
            text-align: center;
            margin-bottom: 28px;
        }

        .logo {
            display: block;

            max-width: 190px;
            max-height: 110px;

            width: auto;
            height: auto;

            object-fit: contain;

            margin: 0 auto 20px;
        }

        .marca h1 {
            color: #222222;
            font-size: 25px;
            margin-bottom: 8px;
        }

        .marca p {
            color: #777777;
            font-size: 14px;
            line-height: 1.5;
        }

        .erro {
            background: #fff1f0;
            color: #b42318;

            border: 1px solid #fecdca;
            border-radius: 10px;

            padding: 12px 14px;

            margin-bottom: 18px;

            font-size: 14px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;

            margin-bottom: 7px;

            color: #333333;

            font-size: 14px;
            font-weight: 600;
        }

        .form-control {
            width: 100%;
            height: 52px;

            border: 1px solid #dddddd;
            border-radius: 10px;

            padding: 0 14px;

            font-size: 17px;

            outline: none;

            background: #ffffff;
        }

        .form-control:focus {
            border-color: #f57c00;

            box-shadow:
                0 0 0 3px rgba(245, 124, 0, 0.12);
        }

        .btn-entrar {
            width: 100%;
            height: 52px;

            border: none;
            border-radius: 10px;

            background: #f57c00;
            color: #ffffff;

            font-size: 16px;
            font-weight: 700;

            cursor: pointer;
        }

        .btn-entrar:hover {
            background: #e66f00;
        }

        .ajuda {
            margin-top: 18px;

            text-align: center;

            color: #888888;

            font-size: 12px;

            line-height: 1.5;
        }

        .rodape {
            text-align: center;

            margin-top: 22px;

            color: #777777;

            font-size: 13px;
        }

        .rodape strong {
            color: #f57c00;
        }

        .whatsapp {
            margin-top: 5px;

            font-size: 11px;

            color: #999999;
        }

        @@media (max-width: 480px) {

            .card {
                padding: 30px 22px;
            }

            .logo {
                max-width: 160px;
            }

        }

    </style>

</head>

<body>

    <div class="pagina">

        <div class="card">

            <div class="marca">

                <img src="@logoEstabelecimento"
                     alt="@nomeEstabelecimento"
                     class="logo" />

                <h1>
                    @nomeEstabelecimento
                </h1>

                <p>
                    Informe seu telefone para acessar
                    o cardápio e fazer seu pedido.
                </p>

            </div>

            @if (ViewBag.Erro != null)
            {
                <div class="erro">
                    @ViewBag.Erro
                </div>
            }

            <form asp-controller="Cliente"
                  asp-action="Acesso"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-group">

                    <label for="telefone">
                        Seu telefone
                    </label>

                    <input id="telefone"
                           name="telefone"
                           type="tel"
                           class="form-control"
                           placeholder="(27) 99999-9999"
                           inputmode="tel"
                           autocomplete="tel"
                           maxlength="20"
                           required
                           autofocus />

                </div>

                <button type="submit"
                        class="btn-entrar">

                    Acessar cardápio

                </button>

            </form>

            <div class="ajuda">
                Use o mesmo número de telefone
                cadastrado no estabelecimento.
            </div>

        </div>

        <div class="rodape">

            <div>
                Desenvolvido por
                <strong>WLC Sistemas</strong>
            </div>

            <div class="whatsapp">
                Whatsapp: (27) 98843-3016
            </div>

        </div>

    </div>

</body>

</html>