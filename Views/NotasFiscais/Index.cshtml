@using WlcSistemaPedidos.Models
@model IEnumerable<NotaFiscal>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Notas Fiscais";

    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalNotas = ViewBag.TotalNotas ?? 0;

    StatusNotaFiscal? statusSelecionado =
        ViewBag.StatusSelecionado as StatusNotaFiscal?;
}

@section Styles {
<style>
.notas-container {
            max-width: 1200px;
            margin: auto;
            padding: 28px 20px 45px;
            min-height: calc(100vh - 145px);
        }

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        h1 {
            margin: 0 0 5px;
            font-size: 28px;
        }

        .subtitulo {
            margin: 0;
            color: #777;
            font-size: 14px;
        }

        .filtros {
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 20px;
        }

        .filtros form {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        select {
            min-width: 220px;
            padding: 11px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
        }

        .btn {
            border: 0;
            border-radius: 8px;
            padding: 11px 16px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-laranja {
            background: #f58220;
            color: #fff;
        }

        .btn-claro {
            background: #fff;
            color: #e96e00;
            border: 1px solid #f58220;
        }

        .tabela-box {
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 950px;
        }

        th,
        td {
            padding: 14px 13px;
            text-align: left;
            border-bottom: 1px solid #eee;
            font-size: 13px;
        }

        th {
            background: #fafafa;
            color: #555;
        }

        .status {
            display: inline-block;
            padding: 6px 9px;
            border-radius: 20px;
            background: #fff2e8;
            color: #e96e00;
            font-weight: 800;
            font-size: 11px;
        }

        .vazio {
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            color: #777;
        }

        .paginacao {
            display: flex;
            justify-content: center;
            gap: 7px;
            margin-top: 25px;
            flex-wrap: wrap;
        }

        .paginacao a,
        .paginacao span {
            min-width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
            color: #333;
            text-decoration: none;
            font-weight: 700;
        }

        .paginacao .ativa {
            background: #f58220;
            color: #fff;
            border-color: #f58220;
        }

        
        @@media(max-width:700px) {
            .cabecalho {
                flex-direction: column;
                align-items: stretch;
            }
        }

</style>
}

<div class="notas-container">
<div class="cabecalho">

        <div>
            <h1>Notas Fiscais</h1>

            <p class="subtitulo">
                @totalNotas registro(s) fiscal(is) encontrado(s)
            </p>
        </div>

        <a asp-controller="NotasFiscais"
           asp-action="PedidosDisponiveis"
           class="btn btn-laranja">
            Pedidos disponíveis
        </a>

    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="filtros">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="filtros">
            @TempData["Erro"]
        </div>
    }

    <section class="filtros">

        <form method="get"
              asp-controller="NotasFiscais"
              asp-action="Index">

            <select name="status">

                <option value="">
                    Todos os status fiscais
                </option>

                @foreach (StatusNotaFiscal status
                    in Enum.GetValues(typeof(StatusNotaFiscal)))
                {
                    if (statusSelecionado == status)
                    {
                        <option value="@((int)status)"
                                selected>
                            @status
                        </option>
                    }
                    else
                    {
                        <option value="@((int)status)">
                            @status
                        </option>
                    }
                }

            </select>

            <button type="submit"
                    class="btn btn-laranja">
                Filtrar
            </button>

            <a asp-controller="NotasFiscais"
               asp-action="Index"
               class="btn btn-claro">
                Limpar
            </a>

        </form>

    </section>

    @if (Model.Any())
    {
        <div class="tabela-box">

            <table>

                <thead>
                    <tr>
                        <th>Nota</th>
                        <th>Pedido</th>
                        <th>Cliente</th>
                        <th>Data</th>
                        <th>Status fiscal</th>
                        <th>Número</th>
                        <th>Total</th>
                        <th>Ação</th>
                    </tr>
                </thead>

                <tbody>

                @foreach (var nota in Model)
                {
                    <tr>

                        <td>
                            <strong>#@nota.Id</strong>
                        </td>

                        <td>
                            #@nota.PedidoId
                        </td>

                        <td>
                            @nota.Pedido.NomeCliente
                        </td>

                        <td>
                            @(nota.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                        </td>

                        <td>
                            <span class="status">
                                @nota.Status
                            </span>
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(
                                nota.NumeroNota))
                            {
                                @nota.NumeroNota
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            <strong>
                                @nota.Pedido.Total.ToString("C2")
                            </strong>
                        </td>

                        <td>

                            <a asp-controller="NotasFiscais"
                               asp-action="Detalhes"
                               asp-route-id="@nota.Id"
                               class="btn btn-claro">
                                Detalhes
                            </a>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

        @if (totalPaginas > 1)
        {
            <nav class="paginacao">

                @for (int i = 1;
                    i <= totalPaginas;
                    i++)
                {
                    if (i == paginaAtual)
                    {
                        <span class="ativa">
                            @i
                        </span>
                    }
                    else
                    {
                        <a asp-controller="NotasFiscais"
                           asp-action="Index"
                           asp-route-pagina="@i"
                           asp-route-status="@statusSelecionado">
                            @i
                        </a>
                    }
                }

            </nav>
        }
    }
    else
    {
        <div class="vazio">
            Nenhuma nota fiscal preparada até o momento.
        </div>
    }
</div>
