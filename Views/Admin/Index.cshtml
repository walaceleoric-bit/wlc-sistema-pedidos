@{
    ViewData["Title"] = "Painel Administrativo";
    Layout = "_AdminLayout";

    int pedidosHoje =
        ViewBag.PedidosHoje ?? 0;
}

@section Styles {

    <style>

        .painel-conteudo {
            width: 90%;
            max-width: 1250px;
            margin: 0 auto;
            padding: 40px 0;
        }

        /* =========================
           CABEÇALHO
           ========================= */

        .topo-painel {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 25px;
            margin-bottom: 32px;
        }

        .boas-vindas {
            flex: 1;
        }

        .boas-vindas h1 {
            font-size: 28px;
            margin: 0 0 8px 0;
        }

        .boas-vindas h1 span {
            color: #f57c00;
        }

        .boas-vindas p {
            color: #777777;
            font-size: 15px;
            margin: 0;
        }

        /* =========================
           PEDIDOS HOJE
           ========================= */

        .pedidos-hoje {
            width: 230px;
            background: #ffffff;
            border-radius: 14px;
            padding: 18px 20px;
            border: 1px solid #eeeeee;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.04);
        }

        .pedidos-hoje-titulo {
            color: #777777;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .pedidos-hoje-valor {
            color: #222222;
            font-size: 27px;
            font-weight: bold;
            line-height: 1;
        }

        .pedidos-hoje-detalhe {
            margin-top: 7px;
            color: #999999;
            font-size: 11px;
        }

        /* =========================
           ACESSO RÁPIDO
           ========================= */

        .atalhos-titulo {
            font-size: 19px;
            margin: 0 0 16px 0;
        }

        .atalhos {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .atalho {
            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 14px;
            padding: 24px 20px;
            text-decoration: none;
            color: #333333;
            transition: .2s;
            min-height: 140px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.025);
        }

        .atalho:hover {
            transform: translateY(-3px);
            border-color: #f57c00;
            box-shadow: 0 8px 22px rgba(245, 124, 0, 0.10);
        }

        .atalho-icone {
            width: 43px;
            height: 43px;
            background: #fff3e6;
            color: #f57c00;
            border-radius: 11px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 21px;
            margin-bottom: 14px;
        }

        .atalho strong {
            display: block;
            margin-bottom: 6px;
            font-size: 15px;
        }

        .atalho span {
            display: block;
            color: #888888;
            font-size: 12px;
            line-height: 1.5;
        }

        /* =========================
           RESPONSIVO
           ========================= */

        @@media (max-width: 950px) {

            .atalhos {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 700px) {

            .topo-painel {
                flex-direction: column;
                align-items: stretch;
            }

            .pedidos-hoje {
                width: auto;
            }
        }

        @@media (max-width: 550px) {

            .painel-conteudo {
                width: 92%;
                padding: 28px 0;
            }

            .atalhos {
                grid-template-columns: 1fr;
            }

            .boas-vindas h1 {
                font-size: 23px;
            }
        }

    </style>
}

<div class="painel-conteudo">

    <!-- =========================
         CABEÇALHO
         ========================= -->

    <section class="topo-painel">

        <div class="boas-vindas">

            <h1>
                Olá, <span>@ViewBag.NomeUsuario</span>
            </h1>

            <p>
                Acompanhe e gerencie o estabelecimento por aqui.
            </p>

        </div>

        <div class="pedidos-hoje">

            <div class="pedidos-hoje-titulo">
                Pedidos hoje
            </div>

            <div class="pedidos-hoje-valor">
                @pedidosHoje
            </div>

            <div class="pedidos-hoje-detalhe">
                Pedidos registrados hoje
            </div>

        </div>

    </section>

    <!-- =========================
         ACESSO RÁPIDO
         ========================= -->

    <h2 class="atalhos-titulo">
        Acesso rápido
    </h2>

    <section class="atalhos">

        <a asp-controller="Produtos"
           asp-action="Index"
           class="atalho">

            <div class="atalho-icone">
                ▣
            </div>

            <strong>
                Produtos
            </strong>

            <span>
                Cadastre produtos, preços, imagens e categorias.
            </span>

        </a>

        <a asp-controller="Clientes"
           asp-action="Index"
           class="atalho">

            <div class="atalho-icone">
                👤
            </div>

            <strong>
                Clientes
            </strong>

            <span>
                Cadastre clientes, gerencie acessos e consulte saldos.
            </span>

        </a>

        <a asp-controller="Pedidos"
           asp-action="Index"
           class="atalho">

            <div class="atalho-icone">
                ☷
            </div>

            <strong>
                Pedidos
            </strong>

            <span>
                Consulte e acompanhe os pedidos recebidos.
            </span>

        </a>

        <a asp-controller="Clientes"
           asp-action="Index"
           class="atalho">

            <div class="atalho-icone">
                R$
            </div>

            <strong>
                Financeiro
            </strong>

            <span>
                Controle pagamentos e valores devidos pelos clientes.
            </span>

        </a>

        <a asp-controller="Lembretes"
           asp-action="Index"
           class="atalho">

            <div class="atalho-icone">
                ⏰
            </div>

            <strong>
                Lembretes
            </strong>

            <span>
                Agende lembretes de pedidos para seus clientes.
            </span>

        </a>

        <a asp-controller="NotasFiscais"
           asp-action="Index"
           class="atalho">

            <div class="atalho-icone">
                NF
            </div>

            <strong>
                Nota Fiscal
            </strong>

            <span>
                Prepare e consulte os registros fiscais dos pedidos.
            </span>

        </a>

    </section>

</div>