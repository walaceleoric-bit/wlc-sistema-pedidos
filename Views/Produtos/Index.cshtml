@using WlcSistemaPedidos.Models
@model IEnumerable<Produto>

@{
    ViewData["Title"] = "Produtos";
    Layout = "_AdminLayout";

    var categorias =
        ViewBag.Categorias as IEnumerable<Categoria>
        ?? Enumerable.Empty<Categoria>();

    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalProdutos = ViewBag.TotalProdutos ?? 0;
    int? categoriaSelecionada = ViewBag.CategoriaId;
    string busca = ViewBag.Busca as string ?? "";
}

@section Styles {
<style>
.produtos-conteudo {
            width: 90%;
            max-width: 1250px;
            margin: 0 auto;
            padding: 35px 0;
            flex: 1;
        }

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .cabecalho h1 {
            font-size: 27px;
            margin-bottom: 6px;
        }

        .cabecalho p {
            color: #777777;
            font-size: 14px;
        }

        .btn-novo {
            background: #f57c00;
            color: #ffffff;
            text-decoration: none;
            padding: 13px 18px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: bold;
            white-space: nowrap;
        }

        .btn-novo:hover {
            background: #e66f00;
        }

        .filtros {
            background: #ffffff;
            padding: 18px;
            border-radius: 13px;
            border: 1px solid #eeeeee;
            margin-bottom: 20px;
        }

        .filtros form {
            display: grid;
            grid-template-columns: 1fr 260px auto auto;
            gap: 10px;
        }

        .campo {
            width: 100%;
            height: 44px;
            border: 1px solid #dddddd;
            border-radius: 8px;
            padding: 0 12px;
            font-size: 14px;
            outline: none;
            background: #ffffff;
        }

        .campo:focus {
            border-color: #f57c00;
            box-shadow: 0 0 0 3px rgba(245, 124, 0, .10);
        }

        .btn-filtrar {
            height: 44px;
            border: none;
            border-radius: 8px;
            background: #333333;
            color: #ffffff;
            padding: 0 18px;
            cursor: pointer;
        }

        .btn-limpar {
            height: 44px;
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #666666;
            padding: 0 15px;
            border: 1px solid #dddddd;
            border-radius: 8px;
            background: #ffffff;
        }

        .resumo {
            margin-bottom: 12px;
            color: #777777;
            font-size: 13px;
        }

        .tabela-container {
            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 13px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 850px;
        }

        th {
            background: #fafafa;
            color: #666666;
            font-size: 12px;
            text-align: left;
            padding: 14px;
            border-bottom: 1px solid #eeeeee;
        }

        td {
            padding: 13px 14px;
            border-bottom: 1px solid #eeeeee;
            font-size: 14px;
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .produto {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .produto-imagem {
            width: 52px;
            height: 52px;
            border-radius: 9px;
            object-fit: cover;
            background: #f3f3f3;
            border: 1px solid #eeeeee;
        }

        .sem-imagem {
            width: 52px;
            height: 52px;
            border-radius: 9px;
            background: #fff3e6;
            color: #f57c00;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            text-align: center;
        }

        .produto strong {
            display: block;
            margin-bottom: 4px;
        }

        .produto small {
            color: #888888;
        }

        .preco {
            font-weight: bold;
        }

        .status {
            display: inline-block;
            padding: 6px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }

        .status-ok {
            background: #eaf8ef;
            color: #207a3c;
        }

        .status-nao {
            background: #fff0f0;
            color: #b42318;
        }

        .acoes {
            display: flex;
            gap: 6px;
        }

        .acao {
            text-decoration: none;
            padding: 7px 10px;
            border-radius: 7px;
            font-size: 12px;
            border: 1px solid #dddddd;
            color: #444444;
            background: #ffffff;
        }

        .acao:hover {
            border-color: #f57c00;
            color: #f57c00;
        }

        .vazio {
            text-align: center;
            padding: 55px 20px;
            color: #777777;
        }

        .vazio strong {
            display: block;
            color: #333333;
            margin-bottom: 7px;
            font-size: 17px;
        }

        .paginacao {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            margin-top: 22px;
            flex-wrap: wrap;
        }

        .pagina {
            min-width: 38px;
            height: 38px;
            padding: 0 10px;
            border: 1px solid #dddddd;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #555555;
            text-decoration: none;
            background: #ffffff;
            font-size: 13px;
        }

        .pagina:hover {
            border-color: #f57c00;
            color: #f57c00;
        }

        .pagina-atual {
            background: #f57c00;
            border-color: #f57c00;
            color: #ffffff;
        }

        
        @@media (max-width: 850px) {
            .filtros form { grid-template-columns: 1fr 1fr; }
        }
        @@media (max-width: 550px) {
            .produtos-conteudo { width: 92%; }
            .cabecalho { align-items: flex-start; flex-direction: column; }
            .filtros form { grid-template-columns: 1fr; }
        }

</style>
}

<div class="produtos-conteudo">
<div class="cabecalho">

            <div>
                <h1>Produtos</h1>

                <p>
                    Gerencie os produtos disponíveis no estabelecimento.
                </p>
            </div>

            <a asp-controller="Produtos"
               asp-action="Criar"
               class="btn-novo">
                + Novo Produto
            </a>

        </div>

        <div class="filtros">

            <form asp-controller="Produtos"
                  asp-action="Index"
                  method="get">

                <input type="text"
                       name="busca"
                       value="@busca"
                       class="campo"
                       placeholder="Pesquisar produto..." />

                <select name="categoriaId"
                        class="campo">

                    <option value="">
                        Todas as categorias
                    </option>

                    @foreach (var categoria in categorias)
                    {
                        if (categoriaSelecionada == categoria.Id)
                        {
                            <option value="@categoria.Id"
                                    selected>
                                @categoria.Nome
                            </option>
                        }
                        else
                        {
                            <option value="@categoria.Id">
                                @categoria.Nome
                            </option>
                        }
                    }

                </select>

                <button type="submit"
                        class="btn-filtrar">
                    Buscar
                </button>

                <a asp-controller="Produtos"
                   asp-action="Index"
                   class="btn-limpar">
                    Limpar
                </a>

            </form>

        </div>

        <div class="resumo">
            @totalProdutos produto(s) encontrado(s)
        </div>

        <div class="tabela-container">

            @if (Model.Any())
            {
                <table>

                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Preço</th>
                            <th>Ativo</th>
                            <th>Disponível</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var produto in Model)
                        {
                            <tr>

                                <td>

                                    <div class="produto">

                                        @if (!string.IsNullOrWhiteSpace(
                                            produto.ImagemUrl))
                                        {
                                            <img src="@produto.ImagemUrl"
                                                 alt="@produto.Nome"
                                                 class="produto-imagem" />
                                        }
                                        else
                                        {
                                            <div class="sem-imagem">
                                                Sem<br />imagem
                                            </div>
                                        }

                                        <div>

                                            <strong>
                                                @produto.Nome
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                produto.Descricao))
                                            {
                                                <small>
                                                    @produto.Descricao
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @produto.Categoria.Nome
                                </td>

                                <td class="preco">
                                    @produto.Preco.ToString(
                                        "C2",
                                        new System.Globalization.CultureInfo(
                                            "pt-BR"))
                                </td>

                                <td>

                                    @if (produto.Ativo)
                                    {
                                        <span class="status status-ok">
                                            Ativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status status-nao">
                                            Inativo
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (produto.Disponivel)
                                    {
                                        <span class="status status-ok">
                                            Disponível
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status status-nao">
                                            Indisponível
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="acoes">

                                        <a asp-controller="Produtos"
                                           asp-action="Editar"
                                           asp-route-id="@produto.Id"
                                           class="acao">
                                            Editar
                                        </a>

                                        <form asp-controller="Produtos"
                                              asp-action="Excluir"
                                              asp-route-id="@produto.Id"
                                              method="post"
                                              onsubmit="return confirm('Tem certeza que deseja excluir o produto @produto.Nome?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="acao"
                                                    style="cursor:pointer;">
                                                Excluir
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="vazio">
                    <strong>
                        Nenhum produto cadastrado
                    </strong>

                    Cadastre o primeiro produto do estabelecimento.
                </div>
            }

        </div>

        @if (totalPaginas > 1)
        {
            <div class="paginacao">

                @if (paginaAtual > 1)
                {
                    <a asp-controller="Produtos"
                       asp-action="Index"
                       asp-route-pagina="@(paginaAtual - 1)"
                       asp-route-busca="@busca"
                       asp-route-categoriaId="@categoriaSelecionada"
                       class="pagina">
                        ‹
                    </a>
                }

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <a asp-controller="Produtos"
                       asp-action="Index"
                       asp-route-pagina="@i"
                       asp-route-busca="@busca"
                       asp-route-categoriaId="@categoriaSelecionada"
                       class="pagina @(i == paginaAtual ? "pagina-atual" : "")">
                        @i
                    </a>
                }

                @if (paginaAtual < totalPaginas)
                {
                    <a asp-controller="Produtos"
                       asp-action="Index"
                       asp-route-pagina="@(paginaAtual + 1)"
                       asp-route-busca="@busca"
                       asp-route-categoriaId="@categoriaSelecionada"
                       class="pagina">
                        ›
                    </a>
                }

            </div>
        }
</div>
