@using WlcSistemaPedidos.Models
@model Cliente

@{
    ViewData["Title"] = "Editar Cliente";
    Layout = null;

    string nomeEstabelecimento =
        ViewBag.NomeEstabelecimento
        ?? "Sistema de Pedidos";

    string logoEstabelecimento =
        ViewBag.LogoEstabelecimento
        ?? "/images/logo-wlc.png";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Editar Cliente - Sistema de Pedidos</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: #f6f7f9;
            color: #262626;
            display: flex;
            flex-direction: column;
        }

        .topo {
            background: #ffffff;
            border-bottom: 1px solid #e8e8e8;
            min-height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 5%;
        }

        .marca {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .logo-wlc {
            width: 95px;
            height: 48px;
            object-fit: contain;
        }

        .nome-sistema {
            border-left: 1px solid #dddddd;
            padding-left: 14px;
        }

        .nome-sistema strong {
            display: block;
            font-size: 15px;
        }

        .nome-sistema span {
            font-size: 12px;
            color: #888888;
        }

        .menu {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .menu a,
        .btn-sair {
            border: none;
            background: transparent;
            color: #444444;
            text-decoration: none;
            padding: 10px 13px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            font-family: inherit;
        }

        .menu a:hover,
        .btn-sair:hover {
            background: #fff3e6;
            color: #f57c00;
        }

        .menu .ativo {
            background: #f57c00;
            color: #ffffff;
        }

        .conteudo {
            width: 90%;
            max-width: 1000px;
            margin: 0 auto;
            padding: 35px 0;
            flex: 1;
        }

        .cabecalho {
            margin-bottom: 24px;
        }

        .cabecalho h1 {
            font-size: 27px;
            margin-bottom: 6px;
        }

        .cabecalho p {
            color: #777777;
            font-size: 14px;
        }

        .card {
            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 14px;
            padding: 25px;
        }

        .secao {
            margin-bottom: 28px;
        }

        .secao:last-child {
            margin-bottom: 0;
        }

        .secao h2 {
            font-size: 17px;
            margin-bottom: 17px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eeeeee;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 17px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: 1fr 160px 1fr;
            gap: 17px;
        }

        .grupo {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .grupo-total {
            grid-column: 1 / -1;
        }

        label {
            font-size: 13px;
            font-weight: bold;
            color: #444444;
        }

        .campo {
            width: 100%;
            min-height: 44px;
            border: 1px solid #dddddd;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 14px;
            outline: none;
            background: #ffffff;
        }

        .campo:focus {
            border-color: #f57c00;
            box-shadow: 0 0 0 3px rgba(245, 124, 0, .10);
        }

        .erro {
            color: #b42318;
            font-size: 12px;
        }

        .validacao {
            background: #fff0f0;
            border: 1px solid #f1b8b8;
            color: #b42318;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .financeiro {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            background: #fafafa;
            border: 1px solid #eeeeee;
            border-radius: 10px;
            padding: 17px;
        }

        .financeiro-texto strong {
            display: block;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .financeiro-texto span {
            color: #777777;
            font-size: 12px;
        }

        .valor-saldo {
            font-size: 20px;
            font-weight: bold;
            white-space: nowrap;
        }

        .saldo-ok {
            color: #207a3c;
        }

        .saldo-devedor {
            color: #b42318;
        }

        .opcoes {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .opcao {
            border: 1px solid #eeeeee;
            border-radius: 10px;
            padding: 15px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: #fafafa;
            cursor: pointer;
        }

        .opcao input {
            margin-top: 3px;
            width: 17px;
            height: 17px;
            accent-color: #f57c00;
        }

        .opcao strong {
            display: block;
            font-size: 14px;
            margin-bottom: 4px;
        }

        .opcao span {
            color: #777777;
            font-size: 12px;
        }

        .info-cadastro {
            margin-top: 17px;
            color: #888888;
            font-size: 12px;
        }

        .acoes {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 25px;
        }

        .btn {
            border: none;
            border-radius: 8px;
            padding: 12px 18px;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            font-family: inherit;
        }

        .btn-voltar {
            background: #ffffff;
            border: 1px solid #dddddd;
            color: #555555;
        }

        .btn-salvar {
            background: #f57c00;
            color: #ffffff;
            font-weight: bold;
        }

        .btn-salvar:hover {
            background: #e66f00;
        }

        .rodape {
            background: #ffffff;
            border-top: 1px solid #e8e8e8;
            text-align: center;
            padding: 18px;
            color: #777777;
            font-size: 12px;
        }

        .rodape strong {
            color: #f57c00;
        }

        @@media (max-width: 750px) {
            .topo {
                flex-direction: column;
                gap: 10px;
                padding: 12px 4%;
            }

            .menu {
                justify-content: center;
            }

            .grid,
            .grid-3,
            .opcoes {
                grid-template-columns: 1fr;
            }

            .grupo-total {
                grid-column: auto;
            }

            .financeiro {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @@media (max-width: 550px) {
            .conteudo {
                width: 92%;
            }

            .card {
                padding: 18px;
            }

            .marca {
                width: 100%;
                justify-content: center;
            }

            .nome-sistema {
                display: none;
            }

            .menu {
                gap: 2px;
            }

            .menu a,
            .btn-sair {
                padding: 8px;
                font-size: 13px;
            }

            .acoes {
                flex-direction: column-reverse;
            }

            .btn {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>

<body>

<header class="topo">

    <div class="marca">

        <img src="@logoEstabelecimento"
             alt="@nomeEstabelecimento"
             class="logo-wlc" />

        <div class="nome-sistema">
            <strong>@nomeEstabelecimento</strong>
            <span>Painel Administrativo</span>
        </div>

    </div>

    <nav class="menu">

        <a asp-controller="Admin"
           asp-action="Index">
            Início
        </a>

        <a asp-controller="Produtos"
           asp-action="Index">
            Produtos
        </a>

        <a asp-controller="Categorias"
           asp-action="Index">
            Categorias
        </a>

        <a asp-controller="Clientes"
           asp-action="Index"
           class="ativo">
            Clientes
        </a>

        <a href="#">NF</a>

        <a href="#">Configurações</a>

        <form asp-controller="Conta"
              asp-action="Sair"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn-sair">
                Sair
            </button>

        </form>

    </nav>

</header>

<main class="conteudo">

    <div class="cabecalho">

        <h1>Editar Cliente</h1>

        <p>
            Atualize os dados e permissões de @Model.Nome.
        </p>

    </div>

    <div class="card">

        <form asp-controller="Clientes"
              asp-action="Editar"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validacao">
            </div>

            <div class="secao">

                <h2>Dados do cliente</h2>

                <div class="grid">

                    <div class="grupo grupo-total">

                        <label asp-for="Nome">
                            Nome *
                        </label>

                        <input asp-for="Nome"
                               class="campo"
                               maxlength="150" />

                        <span asp-validation-for="Nome"
                              class="erro">
                        </span>

                    </div>

                    <div class="grupo">

                        <label asp-for="CpfCnpj">
                            CPF / CNPJ
                        </label>

                        <input asp-for="CpfCnpj"
                               class="campo"
                               maxlength="20" />

                        <span asp-validation-for="CpfCnpj"
                              class="erro">
                        </span>

                    </div>

                    <div class="grupo">

                        <label asp-for="Telefone">
                            Telefone / WhatsApp
                        </label>

                        <input asp-for="Telefone"
                               class="campo"
                               maxlength="20" />

                        <span asp-validation-for="Telefone"
                              class="erro">
                        </span>

                    </div>

                    <div class="grupo grupo-total">

                        <label asp-for="Email">
                            E-mail
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="campo"
                               maxlength="150" />

                        <span asp-validation-for="Email"
                              class="erro">
                        </span>

                    </div>

                </div>

            </div>

            <div class="secao">

                <h2>Endereço</h2>

                <div class="grid">

                    <div class="grupo grupo-total">

                        <label asp-for="Endereco">
                            Endereço
                        </label>

                        <input asp-for="Endereco"
                               class="campo"
                               maxlength="250" />

                        <span asp-validation-for="Endereco"
                              class="erro">
                        </span>

                    </div>

                    <div class="grupo">

                        <label asp-for="Bairro">
                            Bairro
                        </label>

                        <input asp-for="Bairro"
                               class="campo"
                               maxlength="100" />

                        <span asp-validation-for="Bairro"
                              class="erro">
                        </span>

                    </div>

                    <div class="grupo">

                        <label asp-for="Cidade">
                            Cidade
                        </label>

                        <input asp-for="Cidade"
                               class="campo"
                               maxlength="100" />

                        <span asp-validation-for="Cidade"
                              class="erro">
                        </span>

                    </div>

                </div>

                <div class="grid-3"
                     style="margin-top:17px;">

                    <div class="grupo">

                        <label asp-for="Cep">
                            CEP
                        </label>

                        <input asp-for="Cep"
                               class="campo"
                               maxlength="10" />

                        <span asp-validation-for="Cep"
                              class="erro">
                        </span>

                    </div>

                    <div class="grupo">

                        <label asp-for="Numero">
                            Número
                        </label>

                        <input asp-for="Numero"
                               class="campo"
                               maxlength="10" />

                        <span asp-validation-for="Numero"
                              class="erro">
                        </span>

                    </div>

                    <div class="grupo">

                        <label asp-for="Complemento">
                            Complemento
                        </label>

                        <input asp-for="Complemento"
                               class="campo"
                               maxlength="250" />

                        <span asp-validation-for="Complemento"
                              class="erro">
                        </span>

                    </div>

                </div>

            </div>

            <div class="secao">

                <h2>Situação financeira</h2>

                <div class="financeiro">

                    <div class="financeiro-texto">

                        <strong>Saldo atual do cliente</strong>

                        <span>
                            O saldo será alterado somente pelo módulo financeiro,
                            mantendo o histórico de pagamentos e débitos.
                        </span>

                    </div>

                    @if (Model.SaldoDevedor > 0)
                    {
                        <div class="valor-saldo saldo-devedor">

                            @Model.SaldoDevedor.ToString(
                                "C2",
                                new System.Globalization.CultureInfo("pt-BR"))

                        </div>
                    }
                    else
                    {
                        <div class="valor-saldo saldo-ok">
                            Em dia
                        </div>
                    }

                </div>

            </div>

            <div class="secao">

                <h2>Controle</h2>

                <div class="opcoes">

                    <label class="opcao">

                        <input asp-for="Ativo"
                               type="checkbox" />

                        <span>

                            <strong>
                                Cliente ativo
                            </strong>

                            <span>
                                Desmarque para deixar o cadastro inativo.
                            </span>

                        </span>

                    </label>

                    <label class="opcao">

                        <input asp-for="PermitirNovosPedidos"
                               type="checkbox" />

                        <span>

                            <strong>
                                Permitir novos pedidos
                            </strong>

                            <span>
                                Pode ser bloqueado mesmo que o cliente possua
                                cadastro ativo.
                            </span>

                        </span>

                    </label>

                </div>

                <div class="info-cadastro">

                    Cadastrado em:
                    @Model.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")

                </div>

            </div>

            <div class="acoes">

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="btn btn-voltar">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-salvar">
                    Salvar Alterações
                </button>

            </div>

        </form>

    </div>

</main>

<footer class="rodape">
    Desenvolvido por <strong>WLC Sistemas</strong>
</footer>

</body>
</html>