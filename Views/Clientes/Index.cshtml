@using WlcSistemaPedidos.Models
@model IEnumerable<Cliente>

@{
    ViewData["Title"] = "Clientes";
    Layout = "_AdminLayout";

    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalClientes = ViewBag.TotalClientes ?? 0;
    string busca = ViewBag.Busca as string ?? "";
}

@section Styles {

    <style>

        .clientes-conteudo {
            width: 90%;
            max-width: 1250px;
            margin: 0 auto;
            padding: 35px 0;
        }

        /* =========================
           CABEÇALHO
           ========================= */

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        .cabecalho h1 {
            font-size: 27px;
            margin: 0 0 6px 0;
        }

        .cabecalho p {
            color: #777777;
            font-size: 14px;
            margin: 0;
        }

        .btn-novo {
            background: #f57c00;
            color: #ffffff;
            text-decoration: none;
            padding: 13px 18px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: bold;
            white-space: nowrap;
        }

        .btn-novo:hover {
            background: #e66f00;
            color: #ffffff;
        }

        /* =========================
           MENSAGENS
           ========================= */

        .mensagem {
            padding: 13px 15px;
            border-radius: 9px;
            margin-bottom: 18px;
            font-size: 14px;
        }

        .mensagem-sucesso {
            background: #eaf8ef;
            border: 1px solid #b7e4c7;
            color: #207a3c;
        }

        .mensagem-erro {
            background: #fff0f0;
            border: 1px solid #f1b8b8;
            color: #b42318;
        }

        /* =========================
           FILTROS
           ========================= */

        .filtros {
            background: #ffffff;
            padding: 18px;
            border-radius: 13px;
            border: 1px solid #eeeeee;
            margin-bottom: 20px;
        }

        .filtros form {
            display: grid;
            grid-template-columns: 1fr auto auto;
            gap: 10px;
        }

        .campo {
            width: 100%;
            height: 44px;
            border: 1px solid #dddddd;
            border-radius: 8px;
            padding: 0 12px;
            font-size: 14px;
            outline: none;
            background: #ffffff;
        }

        .campo:focus {
            border-color: #f57c00;
            box-shadow: 0 0 0 3px rgba(245, 124, 0, .10);
        }

        .btn-filtrar {
            height: 44px;
            border: none;
            border-radius: 8px;
            background: #333333;
            color: #ffffff;
            padding: 0 18px;
            cursor: pointer;
        }

        .btn-limpar {
            height: 44px;
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #666666;
            padding: 0 15px;
            border: 1px solid #dddddd;
            border-radius: 8px;
            background: #ffffff;
        }

        .btn-limpar:hover {
            border-color: #f57c00;
            color: #f57c00;
        }

        /* =========================
           RESUMO
           ========================= */

        .resumo {
            margin-bottom: 12px;
            color: #777777;
            font-size: 13px;
        }

        /* =========================
           TABELA
           ========================= */

        .tabela-container {
            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 13px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1150px;
        }

        th {
            background: #fafafa;
            color: #666666;
            font-size: 12px;
            text-align: left;
            padding: 14px;
            border-bottom: 1px solid #eeeeee;
        }

        td {
            padding: 13px 14px;
            border-bottom: 1px solid #eeeeee;
            font-size: 14px;
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .cliente-nome strong {
            display: block;
            margin-bottom: 4px;
        }

        .cliente-nome small {
            color: #888888;
        }

        /* =========================
           SALDO
           ========================= */

        .saldo {
            font-weight: bold;
        }

        .saldo-ok {
            color: #207a3c;
        }

        .saldo-devedor {
            color: #b42318;
        }

        /* =========================
           STATUS
           ========================= */

        .status {
            display: inline-block;
            padding: 6px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }

        .status-ok {
            background: #eaf8ef;
            color: #207a3c;
        }

        .status-nao {
            background: #fff0f0;
            color: #b42318;
        }

        /* =========================
           AÇÕES
           ========================= */

        .acoes {
            display: flex;
            gap: 6px;
            align-items: center;
            white-space: nowrap;
        }

        .acoes form {
            margin: 0;
        }

        .acao {
            text-decoration: none;
            padding: 7px 10px;
            border-radius: 7px;
            font-size: 12px;
            border: 1px solid #dddddd;
            color: #444444;
            background: #ffffff;
            cursor: pointer;
            font-family: inherit;
        }

        .acao:hover {
            border-color: #f57c00;
            color: #f57c00;
        }

        .acao-financeiro {
            background: #fff7ed;
            border-color: #ffd4a8;
            color: #d96800;
            font-weight: bold;
        }

        .acao-financeiro:hover {
            background: #f57c00;
            border-color: #f57c00;
            color: #ffffff;
        }

        /* =========================
           SEM CLIENTES
           ========================= */

        .vazio {
            text-align: center;
            padding: 55px 20px;
            color: #777777;
        }

        .vazio strong {
            display: block;
            color: #333333;
            margin-bottom: 7px;
            font-size: 17px;
        }

        /* =========================
           PAGINAÇÃO
           ========================= */

        .paginacao {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            margin-top: 22px;
            flex-wrap: wrap;
        }

        .pagina {
            min-width: 38px;
            height: 38px;
            padding: 0 10px;
            border: 1px solid #dddddd;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #555555;
            text-decoration: none;
            background: #ffffff;
            font-size: 13px;
        }

        .pagina:hover {
            border-color: #f57c00;
            color: #f57c00;
        }

        .pagina-atual {
            background: #f57c00;
            border-color: #f57c00;
            color: #ffffff;
        }

        /* =========================
           RESPONSIVO
           ========================= */

        @@media (max-width: 850px) {

            .filtros form {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 550px) {

            .clientes-conteudo {
                width: 92%;
            }

            .cabecalho {
                align-items: flex-start;
                flex-direction: column;
            }
        }

    </style>
}

<div class="clientes-conteudo">

    @if (TempData["Sucesso"] != null)
    {
        <div class="mensagem mensagem-sucesso">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="mensagem mensagem-erro">
            @TempData["Erro"]
        </div>
    }

    <div class="cabecalho">

        <div>

            <h1>Clientes</h1>

            <p>
                Gerencie os clientes, situação financeira e liberação de novos pedidos.
            </p>

        </div>

        <a asp-controller="Clientes"
           asp-action="Criar"
           class="btn-novo">
            + Novo Cliente
        </a>

    </div>

    <div class="filtros">

        <form asp-controller="Clientes"
              asp-action="Index"
              method="get">

            <input type="text"
                   name="busca"
                   value="@busca"
                   class="campo"
                   placeholder="Pesquisar por nome, CPF/CNPJ ou telefone..." />

            <button type="submit"
                    class="btn-filtrar">
                Buscar
            </button>

            <a asp-controller="Clientes"
               asp-action="Index"
               class="btn-limpar">
                Limpar
            </a>

        </form>

    </div>

    <div class="resumo">
        @totalClientes cliente(s) encontrado(s)
    </div>

    <div class="tabela-container">

        @if (Model.Any())
        {
            <table>

                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Telefone</th>
                        <th>Bairro</th>
                        <th>Cidade</th>
                        <th>Saldo</th>
                        <th>Ativo</th>
                        <th>Novos pedidos</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var cliente in Model)
                    {
                        <tr>

                            <td>

                                <div class="cliente-nome">

                                    <strong>
                                        @cliente.Nome
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(cliente.CpfCnpj))
                                    {
                                        <small>
                                            @cliente.CpfCnpj
                                        </small>
                                    }
                                    else
                                    {
                                        <small>
                                            CPF/CNPJ não informado
                                        </small>
                                    }

                                </div>

                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(cliente.Telefone)
                                    ? "-"
                                    : cliente.Telefone)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(cliente.Bairro)
                                    ? "-"
                                    : cliente.Bairro)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(cliente.Cidade)
                                    ? "-"
                                    : cliente.Cidade)
                            </td>

                            <td>

                                @if (cliente.SaldoDevedor > 0)
                                {
                                    <span class="saldo saldo-devedor">

                                        @cliente.SaldoDevedor.ToString(
                                            "C2",
                                            new System.Globalization.CultureInfo("pt-BR"))

                                    </span>
                                }
                                else
                                {
                                    <span class="saldo saldo-ok">
                                        Em dia
                                    </span>
                                }

                            </td>

                            <td>

                                @if (cliente.Ativo)
                                {
                                    <span class="status status-ok">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="status status-nao">
                                        Inativo
                                    </span>
                                }

                            </td>

                            <td>

                                @if (cliente.PermitirNovosPedidos)
                                {
                                    <span class="status status-ok">
                                        Liberado
                                    </span>
                                }
                                else
                                {
                                    <span class="status status-nao">
                                        Bloqueado
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="acoes">

                                    <a asp-controller="Clientes"
                                       asp-action="Financeiro"
                                       asp-route-id="@cliente.Id"
                                       class="acao acao-financeiro">
                                        Financeiro
                                    </a>

                                    <a asp-controller="Clientes"
                                       asp-action="Editar"
                                       asp-route-id="@cliente.Id"
                                       class="acao">
                                        Editar
                                    </a>

                                    <form asp-controller="Clientes"
                                          asp-action="Excluir"
                                          asp-route-id="@cliente.Id"
                                          method="post"
                                          onsubmit="return confirm('Tem certeza que deseja excluir o cliente @cliente.Nome?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="acao">
                                            Excluir
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="vazio">

                <strong>
                    Nenhum cliente cadastrado
                </strong>

                Cadastre o primeiro cliente do estabelecimento.

            </div>
        }

    </div>

    @if (totalPaginas > 1)
    {
        <div class="paginacao">

            @if (paginaAtual > 1)
            {
                <a asp-controller="Clientes"
                   asp-action="Index"
                   asp-route-pagina="@(paginaAtual - 1)"
                   asp-route-busca="@busca"
                   class="pagina">
                    ‹
                </a>
            }

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <a asp-controller="Clientes"
                   asp-action="Index"
                   asp-route-pagina="@i"
                   asp-route-busca="@busca"
                   class="pagina @(i == paginaAtual ? "pagina-atual" : "")">
                    @i
                </a>
            }

            @if (paginaAtual < totalPaginas)
            {
                <a asp-controller="Clientes"
                   asp-action="Index"
                   asp-route-pagina="@(paginaAtual + 1)"
                   asp-route-busca="@busca"
                   class="pagina">
                    ›
                </a>
            }

        </div>
    }

</div>