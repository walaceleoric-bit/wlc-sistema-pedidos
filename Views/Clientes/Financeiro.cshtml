@using WlcSistemaPedidos.Models
@using WlcSistemaPedidos.ViewModels
@model ClienteFinanceiroViewModel

@{
    ViewData["Title"] = "Financeiro do Cliente";
    Layout = null;

    var cultura =
        new System.Globalization.CultureInfo("pt-BR");

    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalMovimentacoes = ViewBag.TotalMovimentacoes ?? 0;

    string nomeEstabelecimento =
        ViewBag.NomeEstabelecimento
        ?? "Sistema de Pedidos";

    string logoEstabelecimento =
        ViewBag.LogoEstabelecimento
        ?? "/images/logo-wlc.png";
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Financeiro - @Model.NomeCliente</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: #f6f7f9;
            color: #262626;

            display: flex;
            flex-direction: column;
        }

        /* ==========================================
           TOPO
        ========================================== */

        .topo {
            background: #ffffff;
            border-bottom: 1px solid #e8e8e8;
            min-height: 72px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 10px 5%;
        }

        .marca {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .logo-wlc {
            width: 95px;
            height: 48px;
            object-fit: contain;
        }

        .nome-sistema {
            border-left: 1px solid #dddddd;
            padding-left: 14px;
        }

        .nome-sistema strong {
            display: block;
            font-size: 15px;
        }

        .nome-sistema span {
            font-size: 12px;
            color: #888888;
        }

        .menu {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .menu a,
        .btn-sair {
            border: none;
            background: transparent;
            color: #444444;
            text-decoration: none;
            padding: 10px 13px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            font-family: inherit;
        }

        .menu a:hover,
        .btn-sair:hover {
            background: #fff3e6;
            color: #f57c00;
        }

        .menu .ativo {
            background: #f57c00;
            color: #ffffff;
        }

        .menu form {
            margin: 0;
        }

        /* ==========================================
           CONTEÚDO
        ========================================== */

        .conteudo {
            width: 90%;
            max-width: 1250px;
            margin: 0 auto;
            padding: 35px 0 45px;
            flex: 1;
        }

        .voltar {
            display: inline-block;
            color: #666666;
            text-decoration: none;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .voltar:hover {
            color: #f57c00;
        }

        .cabecalho {
            margin-bottom: 25px;
        }

        .cabecalho h1 {
            font-size: 27px;
            margin-bottom: 6px;
        }

        .cabecalho p {
            color: #777777;
            font-size: 14px;
        }

        /* ==========================================
           MENSAGENS
        ========================================== */

        .mensagem {
            padding: 13px 15px;
            border-radius: 9px;
            margin-bottom: 18px;
            font-size: 14px;
        }

        .mensagem-sucesso {
            background: #eaf8ef;
            border: 1px solid #b7e4c7;
            color: #207a3c;
        }

        .mensagem-erro {
            background: #fff0f0;
            border: 1px solid #f1b8b8;
            color: #b42318;
        }

        /* ==========================================
           RESUMO
        ========================================== */

        .resumo-grid {
            display: grid;
            grid-template-columns: 1.3fr 1fr 1fr;
            gap: 15px;
            margin-bottom: 25px;
        }

        .resumo-card {
            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 13px;
            padding: 20px;
        }

        .resumo-card small {
            display: block;
            color: #888888;
            font-size: 12px;
            margin-bottom: 8px;
        }

        .resumo-card strong {
            display: block;
            font-size: 19px;
        }

        .saldo-grande {
            font-size: 25px !important;
        }

        .saldo-ok {
            color: #207a3c;
        }

        .saldo-devedor {
            color: #b42318;
        }

        .status {
            display: inline-block;
            padding: 7px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-ok {
            background: #eaf8ef;
            color: #207a3c;
        }

        .status-nao {
            background: #fff0f0;
            color: #b42318;
        }

        .btn-liberacao {
            margin-top: 12px;
            border: 1px solid #dddddd;
            background: #ffffff;
            color: #444444;
            padding: 8px 11px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
        }

        .btn-liberacao:hover {
            border-color: #f57c00;
            color: #f57c00;
        }

        /* ==========================================
           ÁREA PRINCIPAL
        ========================================== */

        .financeiro-grid {
            display: grid;
            grid-template-columns: 390px 1fr;
            gap: 20px;
            align-items: start;
        }

        .card {
            background: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 13px;
            padding: 22px;
        }

        .card h2 {
            font-size: 18px;
            margin-bottom: 6px;
        }

        .card-subtitulo {
            color: #777777;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        /* ==========================================
           FORMULÁRIO
        ========================================== */

        .grupo {
            margin-bottom: 16px;
        }

        .grupo label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            color: #444444;
            margin-bottom: 7px;
        }

        .campo {
            width: 100%;
            border: 1px solid #dddddd;
            border-radius: 8px;
            padding: 12px;
            outline: none;
            background: #ffffff;
            font-size: 14px;
            font-family: inherit;
        }

        .campo:focus {
            border-color: #f57c00;
            box-shadow: 0 0 0 3px rgba(245,124,0,.10);
        }

        textarea.campo {
            min-height: 100px;
            resize: vertical;
        }

        .validacao {
            display: block;
            color: #b42318;
            font-size: 12px;
            margin-top: 5px;
        }

        .btn-registrar {
            width: 100%;
            border: none;
            background: #f57c00;
            color: #ffffff;
            min-height: 45px;
            padding: 10px 15px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
        }

        .btn-registrar:hover {
            background: #e66f00;
        }

        .aviso {
            margin-top: 15px;
            background: #fff8f0;
            border: 1px solid #f5d3b3;
            border-radius: 8px;
            padding: 12px;
            color: #79502c;
            font-size: 12px;
            line-height: 1.5;
        }

        /* ==========================================
           HISTÓRICO
        ========================================== */

        .tabela-container {
            overflow-x: auto;
            border: 1px solid #eeeeee;
            border-radius: 9px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 720px;
        }

        th {
            background: #fafafa;
            color: #666666;
            font-size: 12px;
            text-align: left;
            padding: 13px;
            border-bottom: 1px solid #eeeeee;
        }

        td {
            padding: 13px;
            font-size: 13px;
            border-bottom: 1px solid #eeeeee;
            vertical-align: top;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .tipo {
            display: inline-block;
            padding: 5px 8px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: bold;
        }

        .tipo-aumenta {
            background: #fff0f0;
            color: #b42318;
        }

        .tipo-reduz {
            background: #eaf8ef;
            color: #207a3c;
        }

        .valor-aumenta {
            color: #b42318;
            font-weight: bold;
        }

        .valor-reduz {
            color: #207a3c;
            font-weight: bold;
        }

        .sem-historico {
            padding: 45px 20px;
            text-align: center;
            color: #777777;
        }

        .sem-historico strong {
            display: block;
            color: #333333;
            margin-bottom: 7px;
        }

        /* ==========================================
           PAGINAÇÃO
        ========================================== */

        .historico-resumo {
            margin-top: 14px;
            color: #777777;
            font-size: 12px;
            text-align: center;
        }

        .paginacao {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            margin-top: 14px;
            flex-wrap: wrap;
        }

        .pagina {
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            border: 1px solid #dddddd;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #555555;
            text-decoration: none;
            background: #ffffff;
            font-size: 12px;
            font-weight: bold;
        }

        .pagina:hover {
            border-color: #f57c00;
            color: #f57c00;
        }

        .pagina-atual {
            background: #f57c00;
            border-color: #f57c00;
            color: #ffffff;
        }

        .pagina-atual:hover {
            background: #e66f00;
            border-color: #e66f00;
            color: #ffffff;
        }

        /* ==========================================
           RODAPÉ
        ========================================== */

        .rodape {
            background: #ffffff;
            border-top: 1px solid #e8e8e8;
            text-align: center;
            padding: 18px;
            color: #777777;
            font-size: 12px;
        }

        .rodape strong {
            color: #f57c00;
        }

        /* ==========================================
           RESPONSIVO
        ========================================== */

        @@media (max-width: 950px) {

            .resumo-grid {
                grid-template-columns: 1fr;
            }

            .financeiro-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 850px) {

            .topo {
                flex-direction: column;
                gap: 10px;
                padding: 12px 4%;
            }

            .menu {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 550px) {

            .conteudo {
                width: 92%;
            }

            .marca {
                width: 100%;
                justify-content: center;
            }

            .nome-sistema {
                display: none;
            }

            .menu {
                gap: 2px;
            }

            .menu a,
            .btn-sair {
                padding: 8px;
                font-size: 13px;
            }
        }

    </style>

</head>

<body>

<header class="topo">

    <div class="marca">

        <img src="@logoEstabelecimento"
             alt="@nomeEstabelecimento"
             class="logo-wlc" />

        <div class="nome-sistema">
            <strong>@nomeEstabelecimento</strong>
            <span>Painel Administrativo</span>
        </div>

    </div>

    <nav class="menu">

        <a asp-controller="Admin"
           asp-action="Index">
            Início
        </a>

        <a asp-controller="Produtos"
           asp-action="Index">
            Produtos
        </a>

        <a asp-controller="Categorias"
           asp-action="Index">
            Categorias
        </a>

        <a asp-controller="Clientes"
           asp-action="Index"
           class="ativo">
            Clientes
        </a>

        <a href="#">
            NF
        </a>

        <a href="#">
            Configurações
        </a>

        <form asp-controller="Conta"
              asp-action="Sair"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn-sair">
                Sair
            </button>

        </form>

    </nav>

</header>

<main class="conteudo">

    <a asp-controller="Clientes"
       asp-action="Index"
       class="voltar">
        ← Voltar para clientes
    </a>

    @if (TempData["Sucesso"] != null)
    {
        <div class="mensagem mensagem-sucesso">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="mensagem mensagem-erro">
            @TempData["Erro"]
        </div>
    }

    <div class="cabecalho">

        <h1>Financeiro do Cliente</h1>

        <p>
            Controle de saldo e movimentações financeiras de
            <strong>@Model.NomeCliente</strong>.
        </p>

    </div>

    <!-- ==========================================
         RESUMO
    =========================================== -->

    <section class="resumo-grid">

        <div class="resumo-card">

            <small>Cliente</small>

            <strong>
                @Model.NomeCliente
            </strong>

        </div>

        <div class="resumo-card">

            <small>Saldo devedor atual</small>

            @if (Model.SaldoDevedor > 0)
            {
                <strong class="saldo-grande saldo-devedor">
                    @Model.SaldoDevedor.ToString("C2", cultura)
                </strong>
            }
            else
            {
                <strong class="saldo-grande saldo-ok">
                    @Model.SaldoDevedor.ToString("C2", cultura)
                </strong>

                <span class="status status-ok"
                      style="margin-top:8px;">
                    Em dia
                </span>
            }

        </div>

        <div class="resumo-card">

            <small>Novos pedidos</small>

            @if (Model.PermitirNovosPedidos)
            {
                <span class="status status-ok">
                    Liberado
                </span>
            }
            else
            {
                <span class="status status-nao">
                    Bloqueado
                </span>
            }

            <form asp-controller="Clientes"
                  asp-action="AlterarLiberacaoPedidos"
                  asp-route-id="@Model.ClienteId"
                  method="post">

                @Html.AntiForgeryToken()

                @if (Model.PermitirNovosPedidos)
                {
                    <button type="submit"
                            class="btn-liberacao"
                            onclick="return confirm('Deseja bloquear novos pedidos para este cliente?');">
                        Bloquear novos pedidos
                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn-liberacao"
                            onclick="return confirm('Deseja liberar novos pedidos para este cliente?');">
                        Liberar novos pedidos
                    </button>
                }

            </form>

        </div>

    </section>

    <section class="financeiro-grid">

        <!-- ======================================
             NOVA MOVIMENTAÇÃO
        ======================================= -->

        <div class="card">

            <h2>Nova movimentação</h2>

            <p class="card-subtitulo">
                Registre pagamentos, débitos ou ajustes no saldo
                do cliente.
            </p>

            <form asp-controller="Clientes"
                  asp-action="Financeiro"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="ClienteId" />

                <div asp-validation-summary="ModelOnly"
                     class="validacao">
                </div>

                <div class="grupo">

                    <label asp-for="Tipo">
                        Tipo da movimentação
                    </label>

                    <select asp-for="Tipo"
                            class="campo">

                        <option value="@((int)TipoMovimentacaoFinanceira.Pagamento)">
                            Pagamento
                        </option>

                        <option value="@((int)TipoMovimentacaoFinanceira.Debito)">
                            Débito
                        </option>

                        <option value="@((int)TipoMovimentacaoFinanceira.AjusteCredito)">
                            Ajuste de crédito
                        </option>

                        <option value="@((int)TipoMovimentacaoFinanceira.AjusteDebito)">
                            Ajuste de débito
                        </option>

                    </select>

                    <span asp-validation-for="Tipo"
                          class="validacao">
                    </span>

                </div>

                <div class="grupo">

                    <label asp-for="Valor">
                        Valor
                    </label>

                    <input asp-for="Valor"
                           class="campo"
                           type="number"
                           min="0.01"
                           step="0.01"
                           placeholder="0,00" />

                    <span asp-validation-for="Valor"
                          class="validacao">
                    </span>

                </div>

                <div class="grupo">

                    <label asp-for="Observacao">
                        Observação
                    </label>

                    <textarea asp-for="Observacao"
                              class="campo"
                              maxlength="500"
                              placeholder="Ex.: Pagamento recebido em dinheiro."></textarea>

                    <span asp-validation-for="Observacao"
                          class="validacao">
                    </span>

                </div>

                <button type="submit"
                        class="btn-registrar"
                        onclick="return confirm('Confirma o registro desta movimentação financeira?');">
                    Registrar movimentação
                </button>

            </form>

            <div class="aviso">
                <strong>Importante:</strong>
                pagamentos e ajustes de crédito reduzem o saldo devedor.
                Débitos e ajustes de débito aumentam o saldo.
                Todas as movimentações ficam registradas no histórico.
            </div>

        </div>

        <!-- ======================================
             HISTÓRICO
        ======================================= -->

        <div class="card">

            <h2>Histórico financeiro</h2>

            <p class="card-subtitulo">
                Movimentações registradas para este cliente,
                da mais recente para a mais antiga.
            </p>

            @if (Model.Movimentacoes.Any())
            {
                <div class="tabela-container">

                    <table>

                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Tipo</th>
                                <th>Valor</th>
                                <th>Observação</th>
                                <th>Responsável</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var movimentacao in Model.Movimentacoes)
                        {
                            bool aumentaSaldo =
                                movimentacao.Tipo ==
                                    TipoMovimentacaoFinanceira.Debito ||
                                movimentacao.Tipo ==
                                    TipoMovimentacaoFinanceira.AjusteDebito;

                            string nomeTipo =
                                movimentacao.Tipo switch
                                {
                                    TipoMovimentacaoFinanceira.Debito =>
                                        "Débito",

                                    TipoMovimentacaoFinanceira.Pagamento =>
                                        "Pagamento",

                                    TipoMovimentacaoFinanceira.AjusteCredito =>
                                        "Ajuste de crédito",

                                    TipoMovimentacaoFinanceira.AjusteDebito =>
                                        "Ajuste de débito",

                                    TipoMovimentacaoFinanceira.Estorno =>
                                        "Estorno",

                                    _ =>
                                        "Movimentação"
                                };

                            var dataFormatada =
                                movimentacao.DataMovimentacao
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm");

                            <tr>

                                <td>
                                    @dataFormatada
                                </td>

                                <td>

                                    <span class="tipo @(aumentaSaldo ? "tipo-aumenta" : "tipo-reduz")">
                                        @nomeTipo
                                    </span>

                                </td>

                                <td class="@(aumentaSaldo ? "valor-aumenta" : "valor-reduz")">

                                    @(aumentaSaldo ? "+" : "-")
                                    @movimentacao.Valor.ToString("C2", cultura)

                                </td>

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        movimentacao.Observacao)
                                        ? "-"
                                        : movimentacao.Observacao)

                                </td>

                                <td>

                                    @(movimentacao.UsuarioResponsavel != null
                                        ? movimentacao.UsuarioResponsavel.Nome
                                        : "-")

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

                <div class="historico-resumo">
                    @totalMovimentacoes movimentação(ões) registrada(s).
                    Exibindo até 10 movimentações por página.
                </div>

                @if (totalPaginas > 1)
                {
                    <nav class="paginacao"
                         aria-label="Paginação do histórico financeiro">

                        @if (paginaAtual > 1)
                        {
                            <a asp-controller="Clientes"
                               asp-action="Financeiro"
                               asp-route-id="@Model.ClienteId"
                               asp-route-pagina="@(paginaAtual - 1)"
                               class="pagina">
                                ‹ Anterior
                            </a>
                        }

                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <a asp-controller="Clientes"
                               asp-action="Financeiro"
                               asp-route-id="@Model.ClienteId"
                               asp-route-pagina="@i"
                               class="pagina @(i == paginaAtual ? "pagina-atual" : "")">
                                @i
                            </a>
                        }

                        @if (paginaAtual < totalPaginas)
                        {
                            <a asp-controller="Clientes"
                               asp-action="Financeiro"
                               asp-route-id="@Model.ClienteId"
                               asp-route-pagina="@(paginaAtual + 1)"
                               class="pagina">
                                Próxima ›
                            </a>
                        }

                    </nav>
                }
            }
            else
            {
                <div class="sem-historico">

                    <strong>
                        Nenhuma movimentação registrada
                    </strong>

                    O histórico financeiro deste cliente
                    aparecerá aqui.

                </div>
            }

        </div>

    </section>

</main>

<footer class="rodape">
    Desenvolvido por <strong>WLC Sistemas</strong>
</footer>

</body>

</html>