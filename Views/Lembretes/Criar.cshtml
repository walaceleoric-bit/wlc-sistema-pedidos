@model WlcSistemaPedidos.Models.LembretePedido

@{
    Layout = null;
    ViewData["Title"] = "Novo lembrete";

    string nomeEstabelecimento =
        ViewBag.NomeEstabelecimento
        ?? "Sistema de Pedidos";

    string logoEstabelecimento =
        ViewBag.LogoEstabelecimento
        ?? "/images/logo-wlc.png";

    var clientes =
        ViewBag.Clientes as
        IEnumerable<WlcSistemaPedidos.Models.Cliente>
        ?? Enumerable.Empty<WlcSistemaPedidos.Models.Cliente>();

    var diasSelecionados =
        ViewBag.DiasSemanaSelecionados as
        IEnumerable<DayOfWeek>;

    var horariosSelecionados =
        ViewBag.HorariosSelecionados as
        IEnumerable<TimeSpan>;

    var dias =
        diasSelecionados?.ToList()
        ?? new List<DayOfWeek>
        {
            Model.DiaSemana
        };

    var horarios =
        horariosSelecionados?.ToList()
        ?? new List<TimeSpan>
        {
            Model.Horario
        };

    if (dias.Count == 0)
    {
        dias.Add(Model.DiaSemana);
    }

    if (horarios.Count == 0)
    {
        horarios.Add(Model.Horario);
    }

    while (horarios.Count < dias.Count)
    {
        horarios.Add(new TimeSpan(8, 0, 0));
    }

    if (dias.Count > 3)
    {
        dias = dias.Take(3).ToList();
    }

    if (horarios.Count > 3)
    {
        horarios = horarios.Take(3).ToList();
    }

    string NomeDia(DayOfWeek dia)
    {
        return dia switch
        {
            DayOfWeek.Monday => "Segunda-feira",
            DayOfWeek.Tuesday => "Terça-feira",
            DayOfWeek.Wednesday => "Quarta-feira",
            DayOfWeek.Thursday => "Quinta-feira",
            DayOfWeek.Friday => "Sexta-feira",
            DayOfWeek.Saturday => "Sábado",
            DayOfWeek.Sunday => "Domingo",
            _ => ""
        };
    }
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Novo lembrete - @nomeEstabelecimento</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f6f7f9;
            color: #292929;
        }

        .topo {
            background: #fff;
            border-bottom: 3px solid #f58220;
            padding: 12px 5%;
        }

        .marca {
            max-width: 850px;
            margin: auto;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .marca img {
            width: 70px;
            height: 50px;
            object-fit: contain;
        }

        .marca strong {
            display: block;
        }

        .marca span {
            color: #777;
            font-size: 12px;
        }

        .container {
            max-width: 720px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .card {
            background: #fff;
            border: 1px solid #e7e7e7;
            border-radius: 14px;
            padding: 28px;
        }

        h1 {
            margin-top: 0;
            margin-bottom: 6px;
        }

        .descricao {
            color: #777;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        .campo {
            margin-bottom: 18px;
        }

        .linha-lembrete {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 12px;
            align-items: end;
            padding: 14px;
            margin-bottom: 12px;
            border: 1px solid #e7e7e7;
            border-radius: 10px;
            background: #fafafa;
        }

        .linha-lembrete .campo {
            margin-bottom: 0;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            font-size: 14px;
        }

        select,
        input,
        textarea {
            width: 100%;
            border: 1px solid #d7d7d7;
            border-radius: 8px;
            padding: 11px;
            font-family: inherit;
            font-size: 14px;
            background: #fff;
        }

        textarea {
            min-height: 130px;
            resize: vertical;
        }

        .ajuda {
            display: block;
            color: #777;
            font-size: 12px;
            margin-top: 6px;
            line-height: 1.4;
        }

        .aviso-recorrencia {
            background: #fff8f1;
            border: 1px solid #f6d5b8;
            border-radius: 9px;
            padding: 13px;
            margin-bottom: 20px;
            color: #6f4a2a;
            font-size: 13px;
            line-height: 1.5;
        }

        .limite {
            margin: 4px 0 14px;
            color: #777;
            font-size: 12px;
            line-height: 1.4;
        }

        .erro {
            color: #b42318;
            font-size: 13px;
            margin-top: 5px;
        }

        .btn-adicionar {
            border: 1px dashed #f58220;
            background: #fff8f1;
            color: #e96e00;
            border-radius: 8px;
            padding: 10px 14px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 18px;
        }

        .btn-adicionar:disabled {
            border-color: #ccc;
            background: #f5f5f5;
            color: #999;
            cursor: not-allowed;
        }

        .btn-remover {
            min-width: 42px;
            height: 42px;
            border: 1px solid #c93030;
            background: #fff;
            color: #c93030;
            border-radius: 8px;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
        }

        .acoes {
            display: flex;
            gap: 10px;
            margin-top: 25px;
            flex-wrap: wrap;
        }

        .btn {
            min-height: 44px;
            padding: 0 18px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .btn-salvar {
            border: 0;
            background: #f58220;
            color: #fff;
        }

        .btn-voltar {
            border: 1px solid #f58220;
            background: #fff;
            color: #e96e00;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #777;
            font-size: 12px;
        }

        footer strong {
            color: #f58220;
        }

        @@media (max-width: 550px) {
            .linha-lembrete {
                grid-template-columns: 1fr;
            }

            .btn-remover {
                width: 100%;
            }

            .acoes {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<header class="topo">

    <div class="marca">

        <img src="@logoEstabelecimento"
             alt="@nomeEstabelecimento" />

        <div>
            <strong>@nomeEstabelecimento</strong>
            <span>Painel Administrativo</span>
        </div>

    </div>

</header>

<main class="container">

    <div class="card">

        <h1>Novo lembrete</h1>

        <div class="descricao">
            Escolha o cliente e programe os dias e horários
            em que os lembretes deverão ser enviados.
        </div>

        <div class="aviso-recorrencia">
            <strong>Lembretes recorrentes:</strong>
            enquanto estiverem ativos, serão enviados
            semanalmente nos dias e horários escolhidos.
            Cada cliente pode ter no máximo
            <strong>3 lembretes ativos.</strong>
        </div>

        <form asp-controller="Lembretes"
              asp-action="Criar"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="erro">
            </div>

            <div class="campo">

                <label asp-for="ClienteId">
                    Cliente
                </label>

                <select asp-for="ClienteId">

                    <option value="">
                        Selecione o cliente
                    </option>

                    @foreach (var cliente in clientes)
                    {
                        <option value="@cliente.Id">
                            @cliente.Nome - @cliente.Telefone
                        </option>
                    }

                </select>

                <span asp-validation-for="ClienteId"
                      class="erro">
                </span>

            </div>

            <div id="lista-lembretes">

                @for (int i = 0; i < dias.Count; i++)
                {
                    <div class="linha-lembrete">

                        <div class="campo">

                            <label>
                                Dia da semana
                            </label>

                            <select name="diasSemana">

                                @foreach (DayOfWeek dia in
                                    Enum.GetValues(typeof(DayOfWeek)))
                                {
                                    if (dias[i] == dia)
                                    {
                                        <option value="@((int)dia)"
                                                selected>
                                            @NomeDia(dia)
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@((int)dia)">
                                            @NomeDia(dia)
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        <div class="campo">

                            <label>
                                Horário
                            </label>

                            <input name="horarios"
                                   type="time"
                                   step="60"
                                   value="@horarios[i].ToString(@"hh\:mm")" />

                        </div>

                        <button type="button"
                                class="btn-remover"
                                title="Remover este horário"
                                onclick="removerLembrete(this)">
                            ×
                        </button>

                    </div>
                }

            </div>

            <button type="button"
                    id="btn-adicionar"
                    class="btn-adicionar"
                    onclick="adicionarLembrete()">
                + Adicionar outro dia e horário
            </button>

            <div class="limite">
                Você pode programar no máximo
                <strong>3 lembretes semanais por cliente.</strong>
            </div>

            <div class="campo">

                <label asp-for="Mensagem">
                    Mensagem
                </label>

                <textarea asp-for="Mensagem"
                          maxlength="1000"></textarea>

                <span class="ajuda">
                    O link individual de acesso do cliente será
                    acrescentado automaticamente no momento do envio.
                </span>

                <span asp-validation-for="Mensagem"
                      class="erro">
                </span>

            </div>

            <div class="acoes">

                <button type="submit"
                        class="btn btn-salvar">
                    Ativar lembrete(s)
                </button>

                <a asp-controller="Lembretes"
                   asp-action="Index"
                   class="btn btn-voltar">
                    Voltar
                </a>

            </div>

        </form>

    </div>

</main>

<footer>
    Desenvolvido por <strong>WLC Sistemas</strong>
</footer>

<script>
    const limiteLembretes = 3;

    function atualizarBotoes() {
        const linhas =
            document.querySelectorAll(".linha-lembrete");

        const botaoAdicionar =
            document.getElementById("btn-adicionar");

        botaoAdicionar.disabled =
            linhas.length >= limiteLembretes;

        linhas.forEach(linha => {
            const botaoRemover =
                linha.querySelector(".btn-remover");

            botaoRemover.style.display =
                linhas.length > 1
                    ? "block"
                    : "none";
        });
    }

    function adicionarLembrete() {
        const lista =
            document.getElementById("lista-lembretes");

        const linhas =
            lista.querySelectorAll(".linha-lembrete");

        if (linhas.length >= limiteLembretes) {
            return;
        }

        const novaLinha =
            document.createElement("div");

        novaLinha.className =
            "linha-lembrete";

        novaLinha.innerHTML = `
            <div class="campo">
                <label>Dia da semana</label>

                <select name="diasSemana">
                    <option value="1">Segunda-feira</option>
                    <option value="2">Terça-feira</option>
                    <option value="3">Quarta-feira</option>
                    <option value="4">Quinta-feira</option>
                    <option value="5">Sexta-feira</option>
                    <option value="6">Sábado</option>
                    <option value="0">Domingo</option>
                </select>
            </div>

            <div class="campo">
                <label>Horário</label>

                <input name="horarios"
                       type="time"
                       step="60"
                       value="08:00" />
            </div>

            <button type="button"
                    class="btn-remover"
                    title="Remover este horário"
                    onclick="removerLembrete(this)">
                ×
            </button>
        `;

        lista.appendChild(novaLinha);

        atualizarBotoes();
    }

    function removerLembrete(botao) {
        const linhas =
            document.querySelectorAll(".linha-lembrete");

        if (linhas.length <= 1) {
            return;
        }

        botao.closest(".linha-lembrete").remove();

        atualizarBotoes();
    }

    atualizarBotoes();
</script>

</body>
</html>
