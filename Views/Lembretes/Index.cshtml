@model IEnumerable<WlcSistemaPedidos.Models.LembretePedido>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lembretes";

    int paginaAtual =
        ViewBag.PaginaAtual != null
            ? (int)ViewBag.PaginaAtual
            : 1;

    int totalPaginas =
        ViewBag.TotalPaginas != null
            ? (int)ViewBag.TotalPaginas
            : 0;

    int totalItens =
        ViewBag.TotalItens != null
            ? (int)ViewBag.TotalItens
            : 0;
}

@section Styles {
    <style>

        .lembretes-container {
            width: 90%;
            max-width: 1150px;
            margin: 35px auto;
        }

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 22px;
            flex-wrap: wrap;
        }

        .cabecalho h1 {
            margin: 0;
            font-size: 27px;
        }

        .cabecalho p {
            margin: 6px 0 0;
            color: #777;
            font-size: 14px;
        }

        .btn-novo {
            background: #f58220;
            color: #fff;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 9px;
            font-weight: bold;
        }

        .mensagem {
            padding: 13px;
            border-radius: 8px;
            margin-bottom: 18px;
        }

        .sucesso {
            background: #eaf8ef;
            color: #246b3b;
        }

        .erro {
            background: #fdecec;
            color: #9b2525;
        }

        .tabela-box {
            background: #fff;
            border: 1px solid #e7e7e7;
            border-radius: 12px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            text-align: left;
            padding: 14px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        th {
            background: #fafafa;
            color: #555;
        }

        .status {
            font-weight: bold;
        }

        .agendado { color: #d56b00; }
        .enviado { color: #23803d; }
        .cancelado { color: #9b2525; }

        .acoes {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .acoes form { margin: 0; }

        .btn-cancelar {
            border: 1px solid #c93030;
            color: #c93030;
            background: #fff;
            border-radius: 7px;
            padding: 7px 10px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-cancelar:hover { background: #fff2f2; }

        .btn-excluir {
            border: 1px solid #777;
            color: #555;
            background: #fff;
            border-radius: 7px;
            padding: 7px 10px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-excluir:hover { background: #f1f1f1; }

        .vazio {
            padding: 35px;
            text-align: center;
            color: #777;
        }

        .rodape-lista {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-top: 18px;
            flex-wrap: wrap;
        }

        .total-registros {
            color: #777;
            font-size: 13px;
        }

        .paginacao {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .paginacao a,
        .paginacao span {
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            text-decoration: none;
            font-size: 14px;
            border: 1px solid #ddd;
            background: #fff;
            color: #444;
        }

        .paginacao a:hover {
            border-color: #f58220;
            color: #f58220;
        }

        .paginacao .pagina-atual {
            background: #f58220;
            border-color: #f58220;
            color: #fff;
            font-weight: bold;
        }

        .paginacao .desabilitado {
            color: #aaa;
            background: #f5f5f5;
        }

        @@media (max-width: 650px) {
            .cabecalho {
                align-items: stretch;
                flex-direction: column;
            }

            .btn-novo { text-align: center; }

            .rodape-lista { justify-content: center; }

            .total-registros {
                width: 100%;
                text-align: center;
            }

            .paginacao { justify-content: center; }
        }

    </style>
}

<div class="lembretes-container">

<div class="cabecalho">
            <div>
                <h1>Lembretes de pedidos</h1>
                <p>
                    Agende lembretes para seus clientes.
                </p>
            </div>

            <a asp-controller="Lembretes"
               asp-action="Criar"
               class="btn-novo">
                + Novo lembrete
            </a>
        </div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="mensagem sucesso">
                @TempData["Sucesso"]
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="mensagem erro">
                @TempData["Erro"]
            </div>
        }

        <div class="tabela-box">

            @if (!Model.Any())
            {
                <div class="vazio">
                    Nenhum lembrete cadastrado.
                </div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Telefone</th>
                            <th>Agendado para</th>
                            <th>Status</th>
                            <th>Ação</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var lembrete in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @lembrete.NomeCliente
                                    </strong>
                                </td>

                                <td>
                                    @lembrete.Telefone
                                </td>

                                <td>
                                    @(lembrete.DataHoraAgendada
                                        .ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>

                                    @if (lembrete.Enviado)
                                    {
                                        <span class="status enviado">
                                            Enviado
                                        </span>
                                    }
                                    else if (!lembrete.Ativo)
                                    {
                                        <span class="status cancelado">
                                            Cancelado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status agendado">
                                            Agendado
                                        </span>
                                    }

                                </td>

                                <td>
                                    <div class="acoes">

                                        @if (!lembrete.Enviado &&
                                             lembrete.Ativo)
                                        {
                                            <form asp-controller="Lembretes"
                                                  asp-action="Cancelar"
                                                  method="post"
                                                  onsubmit="return confirm('Deseja realmente cancelar este lembrete?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@lembrete.Id" />

                                                <button type="submit"
                                                        class="btn-cancelar">
                                                    Cancelar
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Lembretes"
                                                  asp-action="Excluir"
                                                  method="post"
                                                  onsubmit="return confirm('Deseja realmente excluir este lembrete?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@lembrete.Id" />

                                                <button type="submit"
                                                        class="btn-excluir">
                                                    Excluir
                                                </button>

                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            }

        </div>

        @if (totalItens > 0)
        {
            <div class="rodape-lista">

                <div class="total-registros">
                    Total: @totalItens lembrete@(totalItens == 1 ? "" : "s")
                </div>

                @if (totalPaginas > 1)
                {
                    <div class="paginacao">

                        @if (paginaAtual > 1)
                        {
                            <a asp-controller="Lembretes"
                               asp-action="Index"
                               asp-route-pagina="@(paginaAtual - 1)">
                                ‹
                            </a>
                        }
                        else
                        {
                            <span class="desabilitado">
                                ‹
                            </span>
                        }

                        @for (int pagina = 1;
                              pagina <= totalPaginas;
                              pagina++)
                        {
                            if (pagina == paginaAtual)
                            {
                                <span class="pagina-atual">
                                    @pagina
                                </span>
                            }
                            else
                            {
                                <a asp-controller="Lembretes"
                                   asp-action="Index"
                                   asp-route-pagina="@pagina">
                                    @pagina
                                </a>
                            }
                        }

                        @if (paginaAtual < totalPaginas)
                        {
                            <a asp-controller="Lembretes"
                               asp-action="Index"
                               asp-route-pagina="@(paginaAtual + 1)">
                                ›
                            </a>
                        }
                        else
                        {
                            <span class="desabilitado">
                                ›
                            </span>
                        }

                    </div>
                }

            </div>
        }

</div>
